<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Dashboard · Luxe Talent System</title>
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:#0e1117;color:#e8eaf0;font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;line-height:1.5}

/* ── Layout ── */
.dash{display:flex;height:100vh}

/* ── Sidebar ── */
.sidebar{width:220px;background:#131720;border-right:1px solid #1e2330;display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto}
.sb-logo{padding:16px;border-bottom:1px solid #1e2330;display:flex;align-items:center;gap:10px}
.sb-logo-icon{width:32px;height:32px;border-radius:8px;background:#d4a830;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900;color:#0e1117;flex-shrink:0}
.sb-logo-text{font-size:13px;font-weight:700;color:#f1f5f9;letter-spacing:.03em}
.sb-logo-text span{color:#d4a830}
.sb-nav{padding:10px 0;flex:1}
.sb-item{display:flex;align-items:center;gap:10px;padding:9px 16px;font-size:13px;color:#8a8fa8;cursor:default;border-left:3px solid transparent;transition:all .15s}
.sb-item.active{background:rgba(212,168,48,.08);color:#d4a830;border-left-color:#d4a830;cursor:pointer;font-weight:600}
.sb-item.clickable{cursor:pointer}
.sb-item.clickable:hover{background:rgba(212,168,48,.04);color:#c0c4d0}
.sb-item.inactive{opacity:.4;cursor:not-allowed}

@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.sb-blink{animation:blink 1s infinite}
.sb-blink .sb-badge{background:#f87171;color:#fff;font-size:9px;border-radius:50%;padding:1px 5px;margin-left:4px;font-weight:700}
.sb-item svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;flex-shrink:0}
.sb-section{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#3a3f4e;padding:14px 16px 4px}

/* ── Main area ── */
.main{flex:1;overflow-y:auto;display:flex;flex-direction:column}

/* ── Top bar ── */
.topbar{height:52px;border-bottom:1px solid #1e2330;display:flex;align-items:center;justify-content:space-between;padding:0 24px;flex-shrink:0;background:#0e1117}
.topbar-title{font-size:16px;font-weight:600;color:#f1f5f9}
.topbar-user{display:flex;align-items:center;gap:8px;font-size:12px;color:#8a8fa8}
.topbar-avatar{width:28px;height:28px;border-radius:50%;background:#d4a830;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#0e1117}

/* ── Content area ── */
.content{flex:1;padding:24px;overflow-x:auto;min-width:0}

/* ── Tab content ── */
.tab-content{display:none}
.tab-content.active{display:block}

/* ── Performers page ── */
.perf-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px}
.perf-title{font-size:22px;font-weight:700;color:#f1f5f9}
.perf-count{font-size:13px;color:#8a8fa8;font-weight:400;margin-left:8px}
.search-box{display:flex;align-items:center;gap:8px;background:#1a1f2e;border:1px solid #2a2f3e;border-radius:8px;padding:7px 12px;min-width:240px}
.search-box svg{width:16px;height:16px;stroke:#8a8fa8;fill:none;stroke-width:2;flex-shrink:0}
.search-box input{background:none;border:none;outline:none;color:#e8eaf0;font-size:13px;font-family:inherit;width:100%}
.search-box input::placeholder{color:#4a4f5e}

/* ── Table ── */
.ptable{width:100%;border-collapse:collapse;table-layout:auto}
.ptable th:first-child,.ptable td:first-child{min-width:250px}
.ptable th{background:#131720;color:#8a8fa8;font-weight:600;text-transform:uppercase;font-size:10px;letter-spacing:.06em;padding:10px 12px;text-align:left;border-bottom:1px solid #1e2330;position:sticky;top:0}
.ptable td{padding:10px 12px;border-bottom:1px solid rgba(30,35,48,.6);color:#c0c4d0;font-size:13px;vertical-align:middle}
.ptable tr:hover td{background:rgba(212,168,48,.02)}
.ptable .stage{color:#d4a830;font-weight:600}
.ptable .real{color:#e8eaf0}
.ptable .email-col{color:#8a8fa8;font-family:ui-monospace,monospace;font-size:12px}

/* ── Status dropdown ── */
.status-sel{background:#0e1117;border:1px solid #2a2f3e;border-radius:6px;padding:4px 8px;color:#e8eaf0;font-size:12px;font-family:inherit;cursor:pointer;min-width:100px}
.status-sel:focus{outline:none;border-color:#d4a830}
.status-sel option{background:#1a1f2e}

/* Status colors */
.st-registered{color:#4ade80}
.st-pending{color:#fbbf24}
.st-inactive{color:#8a8fa8}
.st-info_needed{color:#60a5fa}
.st-banned{color:#f87171}
.st-active{color:#4ade80}

/* ── Action buttons ── */
.act-btn{background:none;border:1px solid #2a2f3e;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;font-family:inherit;transition:all .15s}
.act-edit{color:#60a5fa;border-color:rgba(96,165,250,.3)}
.act-edit:hover{background:rgba(96,165,250,.1);border-color:#60a5fa}
.act-del{color:#f87171;border-color:rgba(248,113,113,.3)}
.act-del:hover{background:rgba(248,113,113,.1);border-color:#f87171}

/* ── Empty state ── */
.empty{text-align:center;padding:40px;color:#4a4f5e;font-size:14px}

/* ── Loading ── */
.loading{text-align:center;padding:30px;color:#8a8fa8;font-size:13px}

/* ── Toast ── */
.toast{position:fixed;bottom:20px;right:20px;background:#1a1f2e;border:1px solid #2a2f3e;border-radius:10px;padding:12px 18px;font-size:13px;color:#e8eaf0;display:none;z-index:9999;box-shadow:0 8px 24px rgba(0,0,0,.4)}
.toast.ok{border-color:rgba(74,222,128,.4);color:#4ade80}
.toast.err{border-color:rgba(248,113,113,.4);color:#f87171}
.toast.show{display:block}

/* ── Add/Import buttons ── */
.add-btn,.import-btn{border:none;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center}
.add-btn{background:#d4a830;color:#0e1117}
.add-btn:hover{background:#e8bf44}
.import-btn{background:transparent;border:1px solid #2a2f3e;color:#c0c4d0}
.import-btn:hover{border-color:#d4a830;color:#d4a830}

/* ── Sortable headers ── */
.sortable{cursor:pointer;user-select:none;transition:color .15s}
.sortable:hover{color:#d4a830}
.sort-arrow{font-size:10px;margin-left:4px;color:#d4a830}

/* ── Modal ── */
.modal-bg{display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.7);overflow-y:auto;padding:20px;align-items:flex-start;justify-content:center}
.modal-bg.open{display:flex}
.modal-panel{width:100%;max-width:640px;background:#1a1f2e;border:1px solid #2a2f3e;border-radius:14px;margin:20px auto;display:flex;flex-direction:column;max-height:90vh}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #2a2f3e;flex-shrink:0}
.modal-title{font-size:16px;font-weight:600;color:#f1f5f9}
.modal-x{background:none;border:none;color:#8a8fa8;font-size:20px;cursor:pointer}
.modal-x:hover{color:#f1f5f9}
.modal-body{padding:20px;overflow-y:auto;flex:1}
.modal-foot{padding:14px 20px;border-top:1px solid #2a2f3e;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ef{display:flex;flex-direction:column;gap:3px}
.ef.span2{grid-column:1/-1}
.ef label{font-size:10px;color:#8a8fa8;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.ef input,.ef select,.ef textarea{background:#0e1117;border:1px solid #2a2f3e;border-radius:6px;padding:7px 10px;color:#e8eaf0;font-size:13px;font-family:inherit;width:100%;outline:none}
.ef input:focus,.ef select:focus,.ef textarea:focus{border-color:#d4a830}
.ef textarea{resize:vertical;min-height:50px}
.mbtn{padding:8px 18px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;font-family:inherit}
.mbtn-cancel{background:transparent;border:1px solid #2a2f3e;color:#8a8fa8}
.mbtn-cancel:hover{border-color:#d4a830;color:#d4a830}
.mbtn-save{background:#d4a830;color:#0e1117}
.mbtn-save:hover{background:#e8bf44}
.mbtn-save:disabled{opacity:.5;cursor:not-allowed}
.edit-photos{margin-top:14px}
.edit-photos img{width:60px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #2a2f3e;margin:0 4px 4px 0}
.edit-photos .photo-label{font-size:10px;color:#8a8fa8;text-transform:uppercase;margin:8px 0 4px}

/* ── KB AI Search ── */
.kb-ai-box{background:#131720;border:1px solid rgba(74,222,128,.15);border-radius:10px;padding:14px;margin-bottom:16px}
.kb-ai-header{font-size:12px;font-weight:700;color:#4ade80;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.kb-ai-suggestions{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.kb-ai-sug{padding:5px 12px;background:rgba(74,222,128,.06);border:1px solid rgba(74,222,128,.15);color:#4ade80;border-radius:20px;font-size:13px;cursor:pointer;white-space:nowrap}
.kb-ai-sug:hover{background:rgba(74,222,128,.12);border-color:#4ade80}
.kb-ai-chat{max-height:400px;overflow-y:auto;margin-bottom:8px}
.kb-ai-msg{margin-bottom:10px;font-size:15px;line-height:1.7}
.kb-ai-msg.user{color:#d4a830;font-weight:600}
.kb-ai-msg.user::before{content:'You: '}
.kb-ai-msg.ai{color:#e8eaf0;background:rgba(74,222,128,.04);border-left:3px solid #4ade80;padding:10px 14px;border-radius:0 8px 8px 0}
.kb-ai-sources{margin-top:6px;font-size:12px;color:#8a8fa8}
.kb-ai-sources a{color:#d4a830;cursor:pointer;text-decoration:underline;margin-right:8px}
.kb-ai-input-row{display:flex;gap:8px}
.kb-ai-input{flex:1;background:#0e1117;border:1px solid #2a2f3e;border-radius:8px;padding:9px 12px;color:#e8eaf0;font-size:15px;font-family:inherit;outline:none}
.kb-ai-input:focus{border-color:#4ade80}
.kb-ai-input::placeholder{color:#4a4f5e}
.kb-ai-btn{background:#4ade80;color:#0e1117;border:none;border-radius:8px;padding:9px 18px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap}
.kb-ai-btn:hover{background:#22c55e}
.kb-ai-btn:disabled{opacity:.5;cursor:not-allowed}

/* ── Knowledge Base ── */
.kb-layout{display:flex;gap:16px;margin-top:14px}
.kb-cats{width:180px;flex-shrink:0;background:#131720;border:1px solid #1e2330;border-radius:10px;padding:8px;max-height:500px;overflow-y:auto}
.kb-cat-item{padding:7px 10px;font-size:12px;color:#8a8fa8;cursor:pointer;border-radius:6px;margin-bottom:2px;transition:all .15s}
.kb-cat-item:hover{background:rgba(212,168,48,.04);color:#c0c4d0}
.kb-cat-item.active{background:rgba(212,168,48,.1);color:#d4a830;font-weight:600}
.kb-cat-sub{padding:5px 10px 5px 22px;font-size:11px;color:#6a6f7e;cursor:pointer;border-radius:4px}
.kb-cat-sub:hover{color:#c0c4d0}
.kb-cat-sub.active{color:#d4a830}
.kb-cat-count{float:right;font-size:10px;color:#4a4f5e;font-weight:600}
.kb-main{flex:1;overflow-x:auto;min-width:0}
.kb-type{display:inline-block;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.kb-type.pdf{background:rgba(239,68,68,.1);color:#f87171}
.kb-type.docx,.kb-type.doc{background:rgba(96,165,250,.1);color:#60a5fa}
.kb-type.image{background:rgba(74,222,128,.1);color:#4ade80}
.kb-type.link{background:rgba(212,168,48,.1);color:#d4a830}
.kb-type.txt{background:rgba(168,162,158,.1);color:#a8a29e}
.kb-title-link{color:#e8eaf0;text-decoration:none;cursor:pointer;font-weight:500}
.kb-title-link:hover{color:#d4a830;text-decoration:underline}
@media(max-width:768px){.kb-layout{flex-direction:column}.kb-cats{width:100%;max-height:120px;display:flex;gap:4px;flex-wrap:wrap;padding:6px}.kb-cat-item{margin:0}}

/* ── KB Lightbox ── */
.kb-lightbox{display:none;position:fixed;inset:0;z-index:10001;background:rgba(0,0,0,.9);padding:20px;overflow-y:auto}
.kb-lightbox.open{display:flex;align-items:flex-start;justify-content:center}
.kb-lb-panel{background:#1a1f2e;border:1px solid #2a2f3e;border-radius:14px;width:100%;max-width:95vw;margin:20px auto;max-height:95vh;display:flex;flex-direction:column}
.kb-lb-head{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid #2a2f3e;flex-shrink:0}
.kb-lb-title{font-size:15px;font-weight:600;color:#f1f5f9}
.kb-lb-body{flex:1;overflow-y:auto;padding:20px}
.kb-lb-body iframe{width:100%;height:82vh;border:none;border-radius:8px;background:#fff}
.kb-lb-body img{max-width:100%;border-radius:8px}
.kb-lb-body pre{white-space:pre-wrap;font-size:13px;color:#c0c4d0;line-height:1.7;font-family:inherit}
.kb-lb-body a.ext-link{color:#d4a830;font-size:14px;text-decoration:underline}

/* ── Stripchat ── */
.sc-tokens{font-weight:700;color:#d4a830;font-family:ui-monospace,monospace}
.sc-usd{font-weight:600;color:#4ade80;font-family:ui-monospace,monospace}
.sc-neg{color:#f87171}
.sc-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.sc-detail-item{display:flex;justify-content:space-between;padding:6px 10px;background:#0e1117;border-radius:6px;font-size:12px}
.sc-detail-item .label{color:#8a8fa8}
.sc-detail-item .val{color:#e8eaf0;font-weight:600;font-family:ui-monospace,monospace}
.sc-detail-item .val.pos{color:#4ade80}
.sc-detail-item .val.neg{color:#f87171}

/* ── Messages ── */
.msg-unread td{font-weight:600;color:#e8eaf0}
.msg-read td{color:#8a8fa8}
.msg-dot{width:8px;height:8px;border-radius:50%;display:inline-block}
.msg-dot.unread{background:#d4a830}
.sb-newdot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#4ade80;margin-left:7px;box-shadow:0 0 7px rgba(74,222,128,.85);flex-shrink:0}
.msg-dot.read{background:#2a2f3e}
.msg-preview{max-width:250px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px}
.msg-detail{background:#0e1117;border:1px solid #2a2f3e;border-radius:8px;padding:14px;margin-top:12px;font-size:13px;color:#c0c4d0;line-height:1.7;white-space:pre-wrap}

/* ── Leads ── */
.lead-result{padding:3px 8px;border-radius:4px;font-size:10px;font-weight:600;text-transform:uppercase;background:#0e1117;border:1px solid #2a2f3e;color:#e8eaf0;cursor:pointer;font-family:inherit;min-width:90px}
.lead-result:focus{outline:none;border-color:#d4a830}
.lead-chk{width:16px;height:16px;accent-color:#d4a830;cursor:pointer}
.lead-notes{max-width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;color:#8a8fa8}

/* ── Tasks ── */
.task-filters{display:flex;gap:4px}
.tf-btn{background:#1a1f2e;border:1px solid #2a2f3e;color:#8a8fa8;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:5px}
.tf-btn:hover{border-color:#d4a830;color:#c0c4d0}
.tf-btn.active{background:rgba(212,168,48,.1);border-color:#d4a830;color:#d4a830}
.tf-dot{width:8px;height:8px;border-radius:50%;display:inline-block}
.tf-dot.daily{background:#4ade80}
.tf-dot.ongoing{background:#fbbf24}
.tf-dot.urgent{background:#f87171}
.task-priority{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:12px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.task-priority.daily{background:rgba(74,222,128,.1);color:#4ade80}
.task-priority.ongoing{background:rgba(251,191,36,.1);color:#fbbf24}
.task-priority.urgent{background:rgba(248,113,113,.15);color:#f87171}
.task-priority::before{content:'';width:6px;height:6px;border-radius:50%;display:inline-block}
.task-priority.daily::before{background:#4ade80}
.task-priority.ongoing::before{background:#fbbf24}
.task-priority.urgent::before{background:#f87171}
.task-assign{color:#e8eaf0;cursor:pointer;font-weight:500;text-decoration:none}
.task-assign:hover{color:#d4a830;text-decoration:underline}
.task-result{padding:3px 8px;border-radius:4px;font-size:10px;font-weight:600;text-transform:uppercase}
.task-result.pending{background:rgba(138,143,168,.1);color:#8a8fa8}
.task-result.in_progress{background:rgba(96,165,250,.1);color:#60a5fa}
.task-result.completed{background:rgba(74,222,128,.1);color:#4ade80}
.task-result.cancelled{background:rgba(248,113,113,.1);color:#f87171}
.task-cancel-btn{background:none;border:1px solid rgba(248,113,113,.3);color:#f87171;border-radius:6px;padding:3px 10px;font-size:11px;cursor:pointer;font-family:inherit}
.task-cancel-btn:hover{background:rgba(248,113,113,.1);border-color:#f87171}

/* ── Schedule views ── */
.sched-top{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px}
.sched-top-left{display:flex;flex-direction:column;gap:4px}
.sched-date{font-size:13px;color:#8a8fa8}
.sched-sub-tabs{display:flex;gap:6px;flex-wrap:wrap}
.sub-tab{background:#1a1f2e;border:1px solid #2a2f3e;color:#8a8fa8;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit}
.sub-tab:hover{border-color:#d4a830;color:#c0c4d0}
.sub-tab.active{background:rgba(212,168,48,.12);border-color:#d4a830;color:#d4a830}
.add-sched-btn{background:#d4a830!important;color:#0e1117!important;border-color:#d4a830!important}
.add-sched-btn:hover{background:#e8bf44!important}
.date-nav{display:flex;align-items:center;gap:8px;margin-bottom:14px}
.dn-btn{background:transparent;border:1px solid #2a2f3e;color:#c0c4d0;border-radius:5px;padding:4px 10px;font-size:12px;cursor:pointer;font-family:inherit}
.dn-btn:hover{border-color:#d4a830;color:#d4a830}
.month-label{font-size:15px;font-weight:600;color:#e8eaf0;min-width:140px;text-align:center}
.sched-view{display:none}.sched-view.active{display:block}

/* Hourly grid */
.hourly-wrap{overflow-x:auto;border:1px solid #2a2f3e;border-radius:10px;background:#131720}
.hourly-grid{min-width:900px}
.hg-header{display:flex;border-bottom:1px solid #2a2f3e;position:sticky;top:0;background:#131720;z-index:2}
.hg-header .hg-label{width:120px;flex-shrink:0;padding:8px 10px;font-size:10px;font-weight:700;color:#8a8fa8;text-transform:uppercase;letter-spacing:.05em;border-right:1px solid #1e2330}
.hg-header .hg-time{flex:1;min-width:60px;padding:6px 2px;font-size:9px;color:#8a8fa8;text-align:center;border-right:1px solid #1e2330}
.hg-row{display:flex;border-bottom:1px solid rgba(30,35,48,.5);min-height:36px}
.hg-row:hover{background:rgba(212,168,48,.02)}
.hg-row .hg-name{width:120px;flex-shrink:0;padding:8px 10px;font-size:12px;font-weight:600;color:#d4a830;border-right:1px solid #1e2330;display:flex;align-items:center}
.hg-row .hg-cell{flex:1;min-width:60px;border-right:1px solid rgba(30,35,48,.3);position:relative}
.hg-row .hg-cell.filled{background:rgba(74,222,128,.12)}
.hg-row .hg-cell.filled-start{border-radius:4px 0 0 4px}
.hg-row .hg-cell.filled-end{border-radius:0 4px 4px 0}

/* Month calendar */
.month-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:#2a2f3e;border-radius:10px;overflow:hidden}
.mg-head{background:#131720;padding:8px;text-align:center;font-size:10px;font-weight:700;color:#8a8fa8;text-transform:uppercase;letter-spacing:.05em}
.mg-day{background:#1a1f2e;padding:10px 8px;min-height:80px;cursor:pointer;transition:background .15s}
.mg-day:hover{background:rgba(212,168,48,.04)}
