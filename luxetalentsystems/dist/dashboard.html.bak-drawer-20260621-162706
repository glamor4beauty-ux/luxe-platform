<script id="cockpit-js">
(function(){
  function clocks(){
    var z=[['tzET','America/New_York'],['tzCT','America/Chicago'],['tzMT','America/Denver'],
           ['tzPT','America/Los_Angeles'],['tzAK','America/Anchorage'],['tzHI','Pacific/Honolulu']];
    var now=new Date();
    z.forEach(function(p){var el=document.getElementById(p[0]);if(!el)return;
      try{el.textContent=now.toLocaleTimeString('en-US',{timeZone:p[1],hour:'numeric',minute:'2-digit'});}catch(e){}});
  }
  function moveChat(tries){
    var lc=document.getElementById('tab-livechat');
    var host=document.getElementById('lcHost');
    if(lc&&host){
      if(lc.parentNode!==host){
        var ph=document.getElementById('lcPlaceholder'); if(ph) ph.remove();
        host.appendChild(lc);
      }
      lc.style.display='flex';
      lc.classList.add('active');
      if(window.tab_livechat_enter){ try{ window.tab_livechat_enter(); }catch(e){} }
    } else if((tries||0)<20){
      setTimeout(function(){ moveChat((tries||0)+1); },150);
    }
  }
  function dialpad(){
    var num=document.getElementById('cpDialNum');
    document.querySelectorAll('.cp-keys button').forEach(function(b){
      b.addEventListener('click',function(){ if(num) num.value+=b.textContent; });
    });
    var clr=document.getElementById('cpClear');
    if(clr) clr.addEventListener('click',function(){ if(num) num.value=num.value.slice(0,-1); });
  }
  function boot(){ clocks(); setInterval(clocks,30000); dialpad(); moveChat(0); }
  if(document.readyState!=='loading') setTimeout(boot,200); else window.addEventListener('load',function(){ setTimeout(boot,200); });
})();
</script>

<script id="reg-badge-js">
(function(){
  var KEY='luxe_reg_lastseen';
  function getSeen(){ try{ return localStorage.getItem(KEY)||''; }catch(e){ return ''; } }
  function setSeen(v){ try{ localStorage.setItem(KEY,v); }catch(e){} }
  function show(n){
    var b=document.getElementById('regBadge'), c=document.getElementById('regBadgeCount');
    if(!b||!c) return;
    if(n>0){ c.textContent=n; b.style.display='inline-flex'; } else { b.style.display='none'; }
  }
  window.regBadgeSeen=function(){
    // mark all current as seen: set lastseen to newest, clear badge, jump to performers
    fetch('/api/newregs.php',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(d){
      if(d&&d.latest) setSeen(d.latest);
      show(0);
      var perf=document.querySelector('.sb-item[data-tab="performers"]');
      if(perf) perf.click();
    }).catch(function(){ show(0); });
  };
  function poll(){
    var seen=getSeen();
    if(!seen){
      // first run: set baseline to newest, no backlog
      fetch('/api/newregs.php',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(d){
        if(d&&d.latest) setSeen(d.latest); show(0);
      }).catch(function(){});
      return;
    }
    fetch('/api/newregs.php?since='+encodeURIComponent(seen),{credentials:'same-origin'})
      .then(function(r){return r.json();})
      .then(function(d){ var n=(d&&d.registrations)?d.registrations.length:0; show(n); })
      .catch(function(){});
  }
  function boot(){ poll(); setInterval(poll,30000); }
  if(document.readyState!=='loading') setTimeout(boot,400); else window.addEventListener('load',function(){ setTimeout(boot,400); });
})();
</script>


<script id="luxeDashStatusJs">
(function(){
  function init(){
    var btns = document.querySelectorAll('#tab-livechat .ad-lc-status-btn');
    if(!btns.length) return;
    btns.forEach(function(b){
      b.addEventListener('click', function(){
        btns.forEach(function(x){ x.classList.remove('active'); });
        b.classList.add('active');
        var status = b.getAttribute('data-status');
        try { localStorage.setItem('adLcStatus', status); } catch(e){}
        if (typeof window.adLcSetStatus === 'function') { try { window.adLcSetStatus(status); } catch(e){} }
      });
    });
    var saved;
    try { saved = localStorage.getItem('adLcStatus'); } catch(e){}
    var target = document.querySelector('#tab-livechat .ad-lc-status-btn[data-status="' + (saved || 'online') + '"]');
    if (target) target.classList.add('active');
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
