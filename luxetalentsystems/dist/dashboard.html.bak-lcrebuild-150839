window.askKBAIWithText = function(text) {
    $('kbAiInput').value = text;
    askKBAI();
};

window.askKBAI = async function() {
    const input = $('kbAiInput');
    const q = input.value.trim();
    if (!q) return;
    input.value = '';

    const chat = $('kbAiChat');
    chat.innerHTML += `<div class="kb-ai-msg user">${esc(q)}</div>`;
    chat.innerHTML += `<div class="kb-ai-msg ai" id="kbAiLoading" style="color:#8a8fa8">Searching knowledge base...</div>`;
    chat.scrollTop = chat.scrollHeight;

    const btn = $('kbAiBtn');
    btn.disabled = true;

    try {
        const r = await fetch(API + '/ai-kb.php?action=ask', {credentials:'include', 
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ question: q, history: kbAiHistory })
        });
        const d = await r.json();

        // Remove loading
        const loading = $('kbAiLoading');
        if (loading) loading.remove();

        if (d.error) {
            chat.innerHTML += `<div class="kb-ai-msg ai" style="color:#f87171">${esc(d.error)}</div>`;
        } else {
            let html = `<div class="kb-ai-msg ai">${formatAIReply(d.reply)}`;
            if (d.sources && d.sources.length) {
                html += `<div class="kb-ai-sources">Sources: `;
                d.sources.forEach(s => {
                    html += `<a onclick="viewKBFile(${s.id})">${esc(s.title)}</a>`;
                });
                html += `</div>`;
            }
            html += `</div>`;
            chat.innerHTML += html;

            // Update history
            kbAiHistory.push({role:'user', content:q});
            kbAiHistory.push({role:'assistant', content:d.reply});
            if (kbAiHistory.length > 12) kbAiHistory = kbAiHistory.slice(-12);
        }
    } catch(e) {
        const loading = $('kbAiLoading');
        if (loading) loading.remove();
        chat.innerHTML += `<div class="kb-ai-msg ai" style="color:#f87171">Connection error: ${esc(e.message)}</div>`;
    }

    btn.disabled = false;
    chat.scrollTop = chat.scrollHeight;
};

function formatAIReply(text) {
    // Basic formatting: paragraphs and bold
    return esc(text)
        .replace(/\n\n/g, '</p><p>')
        .replace(/\n/g, '<br>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
}

