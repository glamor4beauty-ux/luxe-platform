      .then(function(d){
        var dot=document.getElementById('emailNewDot');
        if(!dot)return;
        var n=(d&&d.unread!=null)?d.unread:((d&&d.messages)?d.messages.length:0);
        dot.style.display=(n>0)?'inline-block':'none';
