  padding:10px 16px; cursor:pointer; user-select:none;
  display:flex; justify-content:space-between; align-items:center;
  font-size:11px; font-weight:600; color:#d4a830;
  text-transform:uppercase; letter-spacing:.05em;
}
#lcOffline .lc-arrow{ display:inline-block; transition:transform .2s; margin-right:6px; }
#lcOffline.lcOpen .lc-arrow{ transform:rotate(180deg); }
#lcOffline .lc-count{ background:#d4a830; color:#0e1117; border-radius:99px; padding:1px 9px; font-size:11px; font-weight:700; }
#lcOffline > .lc-body{ max-height:0; overflow:hidden; transition:max-height .25s; padding:0 12px; }
#lcOffline.lcOpen > .lc-body{ max-height:50vh; overflow-y:auto; padding:6px 12px 12px; }
#lcOffline .lc-item{ background:#0e1117; border:1px solid #2a2f3e; border-radius:8px; padding:10px 12px; font-size:12px; margin-bottom:6px; }
#lcOffline .lc-item .from{ font-weight:600; color:#d4a830; }
#lcOffline .lc-item .meta{ color:#8a8fa8; font-size:11px; margin-top:2px; }
#lcOffline .lc-item .body{ margin-top:6px; color:#e8eaf0; white-space:pre-wrap; line-height:1.45; }
#lcOffline .lc-empty{ padding:14px; text-align:center; color:#8a8fa8; font-size:12px; }
</style>
<script id="lcFinalJs">
(function(){
  function $(id){return document.getElementById(id);}
  function qs(sel,root){return (root||document).querySelector(sel);}
  function esc(t){ return String(t==null?'':t).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }

  function ensureOffline(){
    var tab = $('tab-livechat'); if(!tab) return;
    if ($('lcOffline')) return;
    var p = document.createElement('div');
    p.id = 'lcOffline';
    p.innerHTML =
      '<div class="lc-head" id="lcOffToggle">' +
        '<span><span class="lc-arrow">\u25BC</span>Offline Messages <span class="lc-count" id="lcOffCount" style="display:none">0</span></span>' +
        '<span style="font-size:11px;color:#8a8fa8;text-transform:none;letter-spacing:0">click to expand</span>' +
      '</div>' +
      '<div class="lc-body"><div id="lcOffList"><div class="lc-empty">Loading...</div></div></div>';
    tab.insertBefore(p, tab.firstChild);
    $('lcOffToggle').addEventListener('click', function(){
      p.classList.toggle('lcOpen');
      if (p.classList.contains('lcOpen')) loadOffline();
    });
    loadCount();
    setInterval(loadCount, 30000);
  }

  async function loadCount(){
    try{
      var r = await fetch('/api/chat.php?action=offline_inbox&limit=1',{credentials:'include'});
      var d = await r.json();
      var n = (d && d.unread_count !== undefined) ? d.unread_count : (d && d.messages ? d.messages.length : 0);
      var c = $('lcOffCount'); if(!c) return;
      c.textContent = n; c.style.display = n ? '' : 'none';
    } catch(e){}
  }
  async function loadOffline(){
    var list = $('lcOffList'); if(!list) return;
    try{
      var r = await fetch('/api/chat.php?action=offline_inbox&limit=50',{credentials:'include'});
      var d = await r.json();
      var msgs = (d && d.messages) || [];
      if (!msgs.length){ list.innerHTML = '<div class="lc-empty">No offline messages</div>'; return; }
      list.innerHTML = msgs.map(function(m){
        var from = (m.visitor_name || m.name || '') + (m.visitor_email||m.email ? ' - ' + (m.visitor_email||m.email) : '');
        return '<div class="lc-item">'+
          '<div class="from">'+esc(from)+'</div>'+
          '<div class="meta">'+esc(m.created_at || m.date || '')+'</div>'+
          '<div class="body">'+esc(m.body || m.message || '')+'</div>'+
        '</div>';
      }).join('');
    } catch(e){ list.innerHTML = '<div class="lc-empty">Load failed</div>'; }
  }

  function wrapPanesInCards(){
    var active = qs('#tab-livechat .ad-lc-left .ad-lc-pane:nth-child(1)');
    if (active && !active.classList.contains('lcCard')){
      active.classList.add('lcCard','lcCollapse');
      var list = active.querySelector('#adLcSessList');
      if (list) list.classList.add('lc-body');
      var head = active.querySelector('.ad-lc-pane-head');
      if (head) head.addEventListener('click', function(){ active.classList.toggle('lcOpen'); });
    }
    var right = qs('#tab-livechat .ad-lc-right');
    if (right && !right.classList.contains('lcCard')){
      right.classList.add('lcCard');
      right.id = 'lcThreadCard';
    }
    var head = qs('#tab-livechat .ad-lc-head');
    if (head && !head.classList.contains('lcCard')){
      head.classList.add('lcCard');
    }
  }

  function ensureReply(){
    var tab = $('tab-livechat'); if(!tab) return;
    if ($('lcReply')) return;
    var r = document.createElement('div');
    r.id = 'lcReply';
    r.innerHTML =
      '<div class="lc-head">Your reply</div>' +
      '<textarea id="lcReplyText" rows="3" placeholder="Type your reply..."></textarea>' +
      '<div class="lc-actions">' +
        '<button type="button" id="lcSendBtn">Send Reply</button>' +
        '<span class="status" id="lcSendStatus"></span>' +
      '</div>';
    tab.appendChild(r);
    $('lcSendBtn').addEventListener('click', sendReply);
  }

  async function sendReply(){
    var t = $('lcReplyText'), b = $('lcSendBtn'), st = $('lcSendStatus');
    var msg = (t.value||'').trim(); if (!msg) return;
    var sel = qs('#adLcSessList .ad-lc-item.active') || qs('#adLcSessList .active');
    var sid = sel ? (sel.dataset.id || sel.getAttribute('data-session-id') || sel.getAttribute('data-id')) : '';
    if (!sid){ st.textContent = 'Select an active chat first'; st.style.color = '#f87171'; return; }
    b.disabled = true; st.textContent = 'Sending...'; st.style.color = '#8a8fa8';
    try{
      var r = await fetch('/api/chat.php?action=reply',{
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({session_id:sid, message:msg})
      });
      var d = await r.json();
      if (d && (d.ok || d.success)){ t.value=''; st.textContent='Sent'; st.style.color='#4ade80'; setTimeout(function(){ st.textContent=''; },1500); }
      else { st.textContent = (d && d.error) || 'Send failed'; st.style.color='#f87171'; }
    } catch(e){ st.textContent='Network error'; st.style.color='#f87171'; }
    finally { b.disabled = false; }
  }

  function tick(){
    if (!$('tab-livechat')) return;
    ensureOffline();
    wrapPanesInCards();
    ensureReply();
  }
  tick();
  setInterval(tick, 1500);
  document.addEventListener('DOMContentLoaded', tick);
})();
</script>

</body>
</html>
