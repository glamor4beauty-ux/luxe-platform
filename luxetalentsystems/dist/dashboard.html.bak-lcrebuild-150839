function renderScTable(rows) {
    const body = document.getElementById('scBody');
    const filter = document.getElementById('scPerformerFilter').value;

    // Apply performer filter
    let filtered = rows;
    if (filter) filtered = rows.filter(r => r.model_username === filter || r.stage_name === filter);

    if (!filtered.length) {
        body.innerHTML = '<tr><td colspan="5" class="empty">No data. Click Fetch to pull earnings.</td></tr>';
        document.getElementById('scTotals').style.display = 'none';
        return;
    }

    body.innerHTML = filtered.map(r => {
        const name = ((r.first_name||'') + ' ' + (r.last_name||'')).trim();
        const usd = (r.total_earnings||0) * 0.05;
        const week = (r.period_start ? r.period_start.substring(0,10) : '—') + ' - ' + (r.period_end ? r.period_end.substring(0,10) : '—');
        const paid = r.fetched_at ? r.fetched_at.substring(0,10) : '—';
        return `<tr onclick="scShowPerformerStats('${esc(r.model_username)}',${r.id})" style="cursor:pointer">
            <td class="real">${esc(name)}</td>
            <td class="stage">${esc(r.model_username||r.stage_name||'—')}</td>
            <td style="font-size:12px">${week}</td>
            <td style="font-size:12px">${paid}</td>
            <td style="text-align:right;font-weight:600;font-family:ui-monospace,monospace;color:#e8eaf0">$${usd.toFixed(2)}</td>
        </tr>`;
    }).join('');

    // Calculate totals
    let gross = 0;
    filtered.forEach(r => gross += (r.total_earnings||0) * 0.05);
    const fee = gross * (SC_FEE_PERCENT / 100);
    const unpaid = gross - fee;

    document.getElementById('scTotals').style.display = 'block';
    document.getElementById('scGross').textContent = '$' + gross.toFixed(2);
    document.getElementById('scFee').textContent = '-$' + fee.toFixed(2);
    document.getElementById('scFeePercent').textContent = SC_FEE_PERCENT;
    document.getElementById('scUnpaid').textContent = '$' + unpaid.toFixed(2);
}

