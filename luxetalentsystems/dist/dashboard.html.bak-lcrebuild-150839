<script>
(function(){
  var API = '/api/studio-payouts.php';
  var ALL = [];
  var PERFORMERS = [];

  function $(id){ return document.getElementById(id); }
  function money(n){
    var v = Number(n||0);
    var neg = v < 0;
    v = Math.abs(v);
    return (neg ? '-' : '') + '$' + v.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }
  function esc(s){
    return String(s==null?'':s).replace(/[&<>"]/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];
    });
  }
  function fmtDate(s){
    if (!s) return '—';
    var d = new Date(s + (s.length === 10 ? 'T00:00:00' : ''));
    if (isNaN(d)) return s;
    return d.toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'});
  }
  function buildQS(extra){
    var p = new URLSearchParams();
    var perf = $('spPerfFilter').value.trim();
    var per  = $('spPeriod').value.trim();
    var s    = $('spStart').value.trim();
    var e    = $('spEnd').value.trim();
    if (perf) p.set('performer', perf);
    if (per)  p.set('period', per);
    if (s)    p.set('start_date', s);
    if (e)    p.set('end_date', e);
    if (extra) Object.keys(extra).forEach(function(k){ p.set(k, extra[k]); });
    return p.toString();
  }

  // ── Load performer dropdown (for filter + modal) ──
  async function loadPerformers(){
    try {
      var r = await fetch('/api/performers.php?action=list', {credentials:'include'});
      var d = await r.json();
      PERFORMERS = (d.performers || []).map(function(p){
        return {
          email: p.email,
          name: p.stage_name || ((p.first_name||'') + ' ' + (p.last_name||'')).trim() || p.email
        };
      }).sort(function(a,b){ return (a.name||'').localeCompare(b.name||''); });

      // Populate filter dropdown
      var sel = $('spPerfFilter');
      sel.innerHTML = '<option value="">All Performers</option>'
        + PERFORMERS.map(function(p){
            return '<option value="' + esc(p.email) + '">' + esc(p.name) + '</option>';
          }).join('');
    } catch(e) { PERFORMERS = []; }
  }

  // ── Fetch list + totals ──
  window.spFetch = async function(){
    var qs = buildQS();
    $('spTBody').innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:#8a8fa8">Loading...</td></tr>';
    try {
      var [listRes, totRes] = await Promise.all([
        fetch(API + '?action=list&' + qs, {credentials:'include'}).then(function(r){return r.json();}),
        fetch(API + '?action=totals&' + qs, {credentials:'include'}).then(function(r){return r.json();})
      ]);
      ALL = listRes.payouts || [];
      spRenderTable();
      // Totals
      $('spGross').textContent  = money(totRes.gross_payout || 0);
      $('spFee').textContent    = '-' + money(totRes.studio_fee || 0);
      $('spUnpaid').textContent = money(totRes.total_unpaid || 0);
      $('spFeePercent').textContent = totRes.fee_percent || 20;
    } catch(e) {
      $('spTBody').innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:#f87171">Failed: ' + esc(e.message) + '</td></tr>';
    }
  };

  function spRenderTable(){
    if (!ALL.length) {
      $('spTBody').innerHTML = '<tr><td colspan="6" style="padding:30px;text-align:center;color:#8a8fa8">No payouts match the filters.</td></tr>';
      return;
    }
    $('spTBody').innerHTML = ALL.map(function(p){
      return '<tr style="border-bottom:1px solid #1e2330">'
        +   '<td style="padding:11px 14px">'
        +     '<div style="font-weight:600;color:#e8eaf0">' + esc(p.performer_name || '—') + '</div>'
        +     '<div style="font-size:11px;color:#8a8fa8;margin-top:1px">' + esc(p.performer_email) + '</div>'
        +   '</td>'
        +   '<td style="padding:11px 14px;color:#e8eaf0">' + esc(p.work_performed || '—') + '</td>'
        +   '<td style="padding:11px 14px;text-align:right;font-weight:600;color:#e8eaf0;font-family:ui-monospace,monospace">' + money(p.amount) + '</td>'
        +   '<td style="padding:11px 14px;color:#c0c4d0">' + fmtDate(p.payout_date) + '</td>'
        +   '<td style="padding:11px 14px;text-align:right;font-weight:700;color:#16a34a;font-family:ui-monospace,monospace">' + money(p.amount_paid) + '</td>'
        +   '<td style="padding:11px 14px;text-align:right;white-space:nowrap">'
        +     '<button onclick="spEdit(' + p.id + ')" style="background:transparent;border:1px solid #2a2f3e;color:#e8eaf0;border-radius:5px;padding:4px 9px;font-size:11px;cursor:pointer;margin-right:4px">Edit</button>'
        +     '<button onclick="spDelete(' + p.id + ')" style="background:transparent;border:1px solid #ef4444;color:#ef4444;border-radius:5px;padding:4px 9px;font-size:11px;cursor:pointer">Delete</button>'
        +   '</td>'
        + '</tr>';
    }).join('');
  }

  // ── Modal ──
  function fillPerfPick(selectedEmail){
    var sel = $('spPerfPick');
    sel.innerHTML = '<option value="">— Pick performer —</option>'
      + PERFORMERS.map(function(p){
          return '<option value="' + esc(p.email) + '" data-name="' + esc(p.name) + '"' + (p.email === selectedEmail ? ' selected' : '') + '>' + esc(p.name) + ' · ' + esc(p.email) + '</option>';
        }).join('');
    if (selectedEmail && !sel.value) {
      // Performer not in dropdown (maybe removed) — add as extra
      var opt = document.createElement('option');
      opt.value = selectedEmail;
      opt.textContent = selectedEmail + ' (not in performer list)';
      opt.dataset.name = selectedEmail;
      opt.selected = true;
      sel.appendChild(opt);
    }
  }

  window.spOpenNew = async function(){
    if (!PERFORMERS.length) await loadPerformers();
    $('spModalTitle').textContent = 'Add Payout';
    $('spId').value = '';
    $('spWork').value = '';
    $('spDate').value = new Date().toISOString().slice(0,10);
    $('spAmount').value = '';
    $('spAmountPaid').value = '';
    $('spMethod').value = 'cash';
    $('spMethodDetail').value = '';
    $('spNotes').value = '';
    $('spModalErr').textContent = '';
    fillPerfPick('');
    $('spModal').style.display = 'flex';
  };

  window.spEdit = function(id){
    var p = ALL.find(function(x){ return x.id === id; });
    if (!p) return;
    $('spModalTitle').textContent = 'Edit Payout';
    $('spId').value = p.id;
    $('spWork').value = p.work_performed || '';
    $('spDate').value = p.payout_date || '';
    $('spAmount').value = p.amount || '';
    $('spAmountPaid').value = p.amount_paid || '';
    $('spMethod').value = p.method || 'cash';
    $('spMethodDetail').value = p.method_detail || '';
    $('spNotes').value = p.notes || '';
    $('spModalErr').textContent = '';
    fillPerfPick(p.performer_email);
    $('spModal').style.display = 'flex';
  };

  window.spCloseModal = function(){ $('spModal').style.display = 'none'; };

  window.spSave = async function(){
    var sel = $('spPerfPick');
    var pickedOpt = sel.options[sel.selectedIndex];
    var payload = {
      id:               parseInt($('spId').value || '0', 10) || 0,
      performer_email:  sel.value.trim().toLowerCase(),
      performer_name:   pickedOpt ? (pickedOpt.dataset.name || '') : '',
      work_performed:   $('spWork').value.trim(),
      payout_date:      $('spDate').value,
      amount:           parseFloat($('spAmount').value || '0') || 0,
      amount_paid:      parseFloat($('spAmountPaid').value || '0') || 0,
      method:           $('spMethod').value,
      method_detail:    $('spMethodDetail').value.trim(),
      notes:            $('spNotes').value.trim()
    };

    if (!payload.performer_email) { $('spModalErr').textContent = 'Pick a performer.'; return; }
    if (!payload.payout_date)     { $('spModalErr').textContent = 'Enter the date paid.'; return; }

    var btn = $('spSaveBtn'); btn.disabled = true; btn.textContent = 'Saving...';
    try {
      var r = await fetch(API + '?action=save', {
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });
      var d = await r.json();
      if (d.ok) { spCloseModal(); spFetch(); }
      else { $('spModalErr').textContent = d.error || 'Save failed'; }
    } catch(e) { $('spModalErr').textContent = 'Network: ' + e.message; }
    btn.disabled = false; btn.textContent = 'Save';
  };

  window.spDelete = async function(id){
    var p = ALL.find(function(x){ return x.id === id; });
    if (!p) return;
    if (!confirm('Delete this payout for ' + (p.performer_name || p.performer_email) + '?')) return;
    try {
      var r = await fetch(API + '?action=delete', {
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({id:id})
      });
      var d = await r.json();
      if (d.ok) spFetch();
      else alert(d.error || 'Delete failed');
    } catch(e) { alert('Network error'); }
  };

  // ── Wire events ──
  $('spNewBtn').onclick    = spOpenNew;
  $('spFetchBtn').onclick  = spFetch;

  // Auto-load on first paint
  window.aspLoad = async function(){
    if (!PERFORMERS.length) await loadPerformers();
    spFetch();
  };

  setTimeout(function(){
    if (!PERFORMERS.length) loadPerformers().then(spFetch);
    else spFetch();
  }, 100);
})();
</script>

