<script>
(function(){
  const API = '/api/chat.php';
  const SESS_POLL_MS = 5000;
  const THREAD_POLL_MS = 3000;
  const AGENTS_POLL_MS = 15000;
  const OFFLINE_POLL_MS = 30000;

  let me = null, currentSession = null, threadLastTs = '', sessTimer, threadTimer, agentsTimer, offTimer, audioCtx;
  let pendingUnread = {}; // sessionId → count

  const $ = id => document.getElementById(id);
  const esc = s => String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmtTime = ts => { try{ return new Date(ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}); }catch(e){return ''} };
  const fmtRel  = secs => secs<60?'now':secs<3600?Math.floor(secs/60)+'m':secs<86400?Math.floor(secs/3600)+'h':Math.floor(secs/86400)+'d';

  // ── Status switch (persistent) ────────────────────────────────────────────
  async function loadMyStatus(){
    try{
      const r = await fetch(API + '?action=get_status', {credentials:'include'});
      const d = await r.json();
      if (!r.ok || !d.ok) return;
      me = d;
      const whoami = $('adLcWhoami');
      if (whoami) whoami.textContent = (d.name||'') + ' · ' + (d.role||'admin');
      paintSwitch(d.status);
    }catch(e){}
  }
  function paintSwitch(status){
    document.querySelectorAll('#adLcSwitch .ad-lc-sw-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.status === status);
    });
  }
  async function setStatus(s){
    paintSwitch(s);  // optimistic
    try{
      const r = await fetch(API + '?action=set_status', {credentials:'include', method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({status: s})});
      const d = await r.json();
      if (!r.ok || !d.ok){ alert('Could not change status: ' + (d.error||'')); }
      if (me) me.status = s;
    }catch(e){ alert('Network error.'); }
  }

  // ── Sessions list ─────────────────────────────────────────────────────────
  async function loadSessions(){
    try{
      const r = await fetch(API + '?action=sessions_list&filter=active', {credentials:'include'});
      const d = await r.json();
      if (!r.ok || !d.ok) return;
      const list = $('adLcSessList');
      $('adLcSessCount').textContent = d.sessions.length + ' active';
      if (!d.sessions.length){
        list.innerHTML = '<div class="ad-lc-empty">No active chats</div>';
        return;
      }
      list.innerHTML = d.sessions.map(s => {
        const active = s.id === currentSession ? ' active' : '';
        const unread = s.unread > 0 ? '<span class="ad-lc-unread">' + s.unread + '</span>' : '';
        const last = s.last_message ? esc(String(s.last_message).slice(0, 60)) : '(no messages yet)';
        return '<div class="ad-lc-row' + active + '" data-id="' + esc(s.id) + '">' +
                 '<div class="ad-lc-row-body">' +
                   '<div class="ad-lc-row-name">' + esc(s.visitor_name || 'Visitor') + '</div>' +
                   '<div class="ad-lc-row-sub">' + last + '</div>' +
                 '</div>' +
                 unread +
               '</div>';
      }).join('');
      list.querySelectorAll('.ad-lc-row').forEach(row => {
        row.onclick = () => openThread(row.dataset.id);
      });
    }catch(e){}
  }

  // ── Agents panel ──────────────────────────────────────────────────────────
  async function loadAgents(){
    try{
      const r = await fetch(API + '?action=agents_list', {credentials:'include'});
      const d = await r.json();
      if (!r.ok || !d.ok) return;
      const list = $('adLcAgentList');
      const onlineCount = d.agents.filter(a => a.status === 'online').length;
      $('adLcAgentCount').textContent = onlineCount + ' online';
      list.innerHTML = d.agents.map(a => {
        const cls = a.status; // online | away | offline
        const sub = a.status === 'offline' ? ('last seen ' + fmtRel(a.seconds_ago) + ' ago') : (a.role || 'admin');
        return '<div class="ad-lc-row" style="cursor:default">' +
                 '<div class="ad-lc-dot ' + cls + '"></div>' +
                 '<div class="ad-lc-row-body">' +
                   '<div class="ad-lc-row-name">' + esc(a.name || a.email) + '</div>' +
                   '<div class="ad-lc-row-sub">' + esc(sub) + '</div>' +
                 '</div>' +
               '</div>';
      }).join('');
    }catch(e){}
  }

  // ── Thread (selected chat) ────────────────────────────────────────────────
  async function openThread(id){
    currentSession = id;
    threadLastTs = '';
    if (threadTimer) clearInterval(threadTimer);
    document.querySelectorAll('#adLcSessList .ad-lc-row').forEach(r => r.classList.toggle('active', r.dataset.id === id));
    try{
      const r = await fetch(API + '?action=messages_get&session_id=' + encodeURIComponent(id, {credentials:'include'}));
      const d = await r.json();
      if (!r.ok || !d.ok){ alert(d.error||'Failed to load'); return; }
      paintThread(d.session, d.messages);
      $('adLcThreadInput').style.display = d.session.status === 'active' ? 'block' : 'none';
      // Start cursor at the latest message
      if (d.messages.length) threadLastTs = d.messages[d.messages.length-1].created_at;
      threadTimer = setInterval(pollThread, THREAD_POLL_MS);
      loadSessions();  // unread counts will refresh
    }catch(e){}
  }
  function paintThread(session, messages){
    $('adLcThreadHead').innerHTML =
      '<div><div class="ad-lc-thread-name">' + esc(session.visitor_name || 'Visitor') + '</div>' +
      '<div class="ad-lc-thread-email">' + esc(session.visitor_email || '') + ' · ' + esc(session.status) + '</div></div>';
    const box = $('adLcThreadMsgs');
    box.innerHTML = messages.map(m => renderMsg(m)).join('');
    box.scrollTop = box.scrollHeight;
  }
  function renderMsg(m){
    const cls = m.sender_type === 'visitor' ? 'visitor' : m.sender_type === 'system' ? 'system' : 'agent';
    const name = m.sender_type === 'agent' ? '<div class="name">' + esc(m.sender_name||'Agent') + '</div>' : '';
    const time = m.sender_type === 'system' ? '' : '<div class="ct">' + fmtTime(m.created_at) + '</div>';
    return '<div class="chat-msg ' + cls + '">' + name + esc(m.message) + time + '</div>';
  }
  async function pollThread(){
    if (!currentSession) return;
    try{
      const r = await fetch(API + '?action=poll&session_id=' + encodeURIComponent(currentSession, {credentials:'include'}) + '&last_ts=' + encodeURIComponent(threadLastTs||''));
      const d = await r.json();
      if (!r.ok || !d.ok) return;
      let gotVisitor = false;
      d.messages.forEach(m => {
        threadLastTs = m.created_at;
        const box = $('adLcThreadMsgs');
        box.insertAdjacentHTML('beforeend', renderMsg(m));
        box.scrollTop = box.scrollHeight;
        if (m.sender_type === 'visitor') gotVisitor = true;
      });
      $('adLcThreadTyping').style.display = (d.status === 'active' && d.messages_typing) ? 'block' : 'none';
      // Visitor typing flag comes from the session, not messages; poll endpoint returns it differently
      // For now we rely on session.typing via messages_get if needed
      if (gotVisitor) chime();
      if (d.status === 'closed'){
        $('adLcThreadInput').style.display = 'none';
      }
    }catch(e){}
  }
  async function sendReply(){
    const ta = $('adLcReplyInput');
    const msg = ta.value.trim();
    if (!msg || !currentSession) return;
    ta.value = '';
    $('adLcReplyBtn').disabled = true;
    try{
      const r = await fetch(API + '?action=reply', {credentials:'include', method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({session_id: currentSession, message: msg})});
      const d = await r.json();
      if (!r.ok || !d.ok){ alert(d.error||'Failed to send'); }
      await pollThread();
    }catch(e){ alert('Network error'); }
    $('adLcReplyBtn').disabled = false;
  }
  async function closeChat(){
    if (!currentSession || !confirm('Close this chat session?')) return;
    try{
      await fetch(API + '?action=close_session', {credentials:'include', method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({session_id: currentSession})});
      $('adLcThreadInput').style.display = 'none';
      await pollThread();
      loadSessions();
    }catch(e){}
  }

  // ── Offline messages inbox ────────────────────────────────────────────────
  async function loadOffline(){
    try{
      const r = await fetch(API + '?action=offline_inbox&limit=50', {credentials:'include'});
      const d = await r.json();
      if (!r.ok || !d.ok) return;
      const list = $('adLcOfflineList');
      const unread = d.messages.filter(m => !m.is_read).length;
      const badge = $('adLcOfflineBadge');
      if (unread > 0){ badge.style.display = 'inline-block'; badge.textContent = unread; }
      else           { badge.style.display = 'none'; }
      if (!d.messages.length){ list.innerHTML = '<div class="ad-lc-empty">No offline messages</div>'; return; }
      list.innerHTML = d.messages.map(m => {
        const cls = m.is_read ? '' : ' unread';
        return '<div class="ad-lc-off-row' + cls + '" data-id="' + m.id + '">' +
                 '<div class="ad-lc-off-from">' + esc(m.subject || 'Message') + '</div>' +
                 '<div class="ad-lc-off-sub">From: ' + esc(m.from_email) + ' · <span class="ad-lc-off-time">' + esc(m.created_at) + '</span></div>' +
                 '<div class="ad-lc-off-body">' + esc(m.body) + '</div>' +
               '</div>';
      }).join('');
      list.querySelectorAll('.ad-lc-off-row').forEach(row => {
        row.onclick = async () => {
          if (!row.classList.contains('unread')) return;
          row.classList.remove('unread');
          try{ await fetch(API+'?action=mark_read', {credentials:'include', method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({id: parseInt(row.dataset.id,10)})}); }catch(e){}
          loadOffline();
        };
      });
    }catch(e){}
  }

  // ── Tabs (Chat / Offline) ─────────────────────────────────────────────────
  document.querySelectorAll('#tab-livechat .ad-lc-tab').forEach(t => {
    t.onclick = () => {
      document.querySelectorAll('#tab-livechat .ad-lc-tab').forEach(x => x.classList.remove('active'));
      t.classList.add('active');
      const view = t.dataset.view;
      $('adLcViewThread').style.display  = view === 'thread'  ? 'flex' : 'none';
      $('adLcViewOffline').style.display = view === 'offline' ? 'flex' : 'none';
      if (view === 'offline') loadOffline();
    };
  });

  // ── Chime ─────────────────────────────────────────────────────────────────
  function chime(){
    try{
      if (!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)();
      const o = audioCtx.createOscillator(), g = audioCtx.createGain();
      o.connect(g); g.connect(audioCtx.destination);
      o.frequency.setValueAtTime(880, audioCtx.currentTime);
      o.frequency.exponentialRampToValueAtTime(660, audioCtx.currentTime + 0.2);
      g.gain.setValueAtTime(0.18, audioCtx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
      o.start(); o.stop(audioCtx.currentTime + 0.3);
    }catch(e){}
  }

  // ── Wiring ────────────────────────────────────────────────────────────────
  document.querySelectorAll('#adLcSwitch .ad-lc-sw-btn').forEach(b => {
    b.onclick = () => setStatus(b.dataset.status);
  });
  $('adLcReplyBtn').onclick = sendReply;
  $('adLcCloseBtn').onclick = closeChat;
  $('adLcReplyInput').addEventListener('keydown', e => {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)){ e.preventDefault(); sendReply(); }
  });

  // ── Boot / polling lifecycle ──────────────────────────────────────────────
  // Called by the existing tab system when this tab activates. Falls back to
  // window load if no tab system event fires.
  window.tab_livechat_enter = function(){
    loadMyStatus();
    loadSessions();
    loadAgents();
    loadOffline();
    if (sessTimer)   clearInterval(sessTimer);
    if (agentsTimer) clearInterval(agentsTimer);
    if (offTimer)    clearInterval(offTimer);
    sessTimer   = setInterval(loadSessions, SESS_POLL_MS);
    agentsTimer = setInterval(loadAgents,   AGENTS_POLL_MS);
    offTimer    = setInterval(loadOffline,  OFFLINE_POLL_MS);
  };
  window.tab_livechat_leave = function(){
    if (sessTimer)   { clearInterval(sessTimer);   sessTimer = null; }
    if (threadTimer) { clearInterval(threadTimer); threadTimer = null; }
    if (agentsTimer) { clearInterval(agentsTimer); agentsTimer = null; }
    if (offTimer)    { clearInterval(offTimer);    offTimer = null; }
  };

  // Auto-boot once on page load — safe even if tab isn't visible (just polls in background)
  window.addEventListener('load', () => window.tab_livechat_enter());
})();
</script>

