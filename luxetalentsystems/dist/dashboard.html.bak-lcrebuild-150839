// ── Load performers ──
async function loadPerformers(search) {
    const body = $('perfBody');
    body.innerHTML = '<tr><td colspan="5" class="loading">Loading...</td></tr>';
    try {
        const q = search ? '&search=' + encodeURIComponent(search) : '';
        const r = await fetch(API + '/performers.php?action=list' + q, {credentials:'include'});
        const rows = await r.json();
        if (rows.error) throw new Error(rows.error);
        allPerformers = rows;
        renderPerformers();
    } catch (e) {
        body.innerHTML = '<tr><td colspan="5" class="empty" style="color:#f87171">Error: ' + esc(e.message) + '</td></tr>';
    }
}

function renderPerformers() {
    const body = $('perfBody');
    $('perfCount').textContent = allPerformers.length + ' total';
    if (!allPerformers.length) {
        body.innerHTML = '<tr><td colspan="5" class="empty">No performers found</td></tr>';
        return;
    }
    // Sort
    const sorted = [...allPerformers].sort((a, b) => {
        let va = '', vb = '';
        if (sortField === 'last_name') {
            va = ((a.first_name||'') + ' ' + (a.last_name||'')).trim().toLowerCase();
            vb = ((b.first_name||'') + ' ' + (b.last_name||'')).trim().toLowerCase();
        } else if (sortField === 'created_at') {
            // Compare timestamps chronologically
            va = a.created_at || '';
            vb = b.created_at || '';
            const cmp = va < vb ? -1 : (va > vb ? 1 : 0);
            return sortDir === 'asc' ? cmp : -cmp;
        } else {
            va = (a[sortField] || '').toLowerCase();
            vb = (b[sortField] || '').toLowerCase();
        }
        if (va < vb) return sortDir === 'asc' ? -1 : 1;
        if (va > vb) return sortDir === 'asc' ? 1 : -1;
        return 0;
    });
    body.innerHTML = sorted.map(p => {
        const stClass = 'st-' + (p.status || 'pending');
        const realName = ((p.first_name || '') + ' ' + (p.last_name || '')).trim();
        return `<tr data-email="${p.email}">
            <td class="stage"><a href="performer-view.html?email=${encodeURIComponent(p.email)}" style="color:#d4a830;text-decoration:none;font-weight:600" target="_blank">${esc(p.stage_name || '—')}</a></td>
            <td><select class="role-sel" onchange="updatePerfRole('${esc(p.email)}',this.value,this)" style="background:#1a1f2e;border:1px solid #2a2f3e;border-radius:6px;color:#e8eaf0;font-size:12px;padding:4px 6px;font-family:inherit;cursor:pointer"><option value="performer" ${(p.system_role||'performer')==='performer'?'selected':''}>Performer</option><option value="studio" ${p.system_role==='studio'?'selected':''}>Studio</option><option value="administrator" ${p.system_role==='administrator'?'selected':''}>Admin</option><option value="agent" ${p.system_role==='agent'?'selected':''}>Agent</option></select></td>
            <td class="real">${esc(realName)}</td>
            <td class="email-col"><a href="#" onclick="openEmailTo('${p.email}');return false;" style="color:#d4a830;text-decoration:none">${esc(p.email||'—')}</a></td>
            <td>
                <select class="status-sel ${stClass}" onchange="updateStatus('${esc(p.email)}',this.value,this)">
                    <option value="registered" ${p.status==='registered'?'selected':''}>Registered</option>
                    <option value="pending" ${p.status==='pending'?'selected':''}>Pending</option>
                    <option value="active" ${p.status==='active'?'selected':''}>Active</option>
                    <option value="inactive" ${p.status==='inactive'?'selected':''}>Inactive</option>
                    <option value="info_needed" ${p.status==='info_needed'?'selected':''}>Info Needed</option>
                    <option value="banned" ${p.status==='banned'?'selected':''}>Banned</option>
                </select>
            </td>
