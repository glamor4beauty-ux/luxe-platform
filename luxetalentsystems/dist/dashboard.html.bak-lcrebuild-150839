window.viewMessage = async function(id) {
    // Mark as read
    try {
        await fetch(API + '/messages.php?action=mark_read', {credentials:'include', 
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({id})
        });
    } catch(e) {}

    // Find the row and toggle detail
    const existing = document.getElementById('msgDetail_' + id);
    if (existing) { existing.remove(); return; }

    // Remove any other open details
    document.querySelectorAll('[id^="msgDetail_"]').forEach(e => e.remove());

    // Fetch full message
    try {
        const r = await fetch(API + '/messages.php?action=inbox&email=' + encodeURIComponent(ADMIN_EMAIL, {credentials:'include'}));
        const rows = await r.json();
        const msg = rows.find(m => m.id == id);
        if (!msg) {
            const r2 = await fetch(API + '/messages.php?action=sent&email=' + encodeURIComponent(ADMIN_EMAIL, {credentials:'include'}));
            const rows2 = await r2.json();
            const msg2 = rows2.find(m => m.id == id);
            if (msg2) showMsgDetail(id, msg2);
            return;
        }
        showMsgDetail(id, msg);
    } catch(e) {}
};

function showMsgDetail(id, msg) {
    const rows = document.querySelectorAll('#msgBody tr');
    for (const row of rows) {
        if (row.innerHTML.includes('viewMessage(' + id + ')')) {
            // Update row to show as read
            row.className = 'msg-read';
            const dot = row.querySelector('.msg-dot');
            if (dot) { dot.className = 'msg-dot read'; }

            const detailRow = document.createElement('tr');
            detailRow.id = 'msgDetail_' + id;
            const name = ((msg.first_name||'') + ' ' + (msg.last_name||'')).trim() || msg.from_email;
            detailRow.innerHTML = `<td colspan="6" style="padding:0 12px 12px">
                <div class="msg-detail">
                    <div style="font-size:11px;color:#8a8fa8;margin-bottom:8px">
                        <strong>From:</strong> ${esc(msg.from_email)} &nbsp;|&nbsp;
                        <strong>To:</strong> ${esc(msg.to_email)} &nbsp;|&nbsp;
                        <strong>Date:</strong> ${msg.created_at || '—'}
                    </div>
                    ${msg.subject ? '<div style="font-weight:600;color:#d4a830;margin-bottom:6px">' + esc(msg.subject) + '</div>' : ''}
                    <div>${esc(msg.body)}</div>
                    <div style="margin-top:10px;display:flex;gap:8px">
                        <button class="mbtn mbtn-save" style="padding:6px 14px;font-size:12px" onclick="replyToMsg('${esc(msg.from_email)}','${esc(msg.subject||'')}')">Reply</button>
