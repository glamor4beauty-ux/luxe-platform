<script>
(function(){
  var API = '/api/performer-accounts.php';
  var ALL = [];

  function $(id){ return document.getElementById(id); }
  function esc(s){
    return String(s==null?'':s).replace(/[&<>"]/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];
    });
  }
  function fmtDate(s){
    if (!s) return '—';
    var d = new Date(s.replace(' ', 'T'));
    if (isNaN(d)) return s;
    var now = new Date();
    var dayMs = 86400000;
    var diff = Math.floor((now - d) / dayMs);
    if (diff === 0) return 'Today, ' + d.toLocaleTimeString('en-US', {hour:'numeric',minute:'2-digit'});
    if (diff === 1) return 'Yesterday';
    if (diff < 7)   return diff + ' days ago';
    return d.toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'});
  }
  function genPw(){
    var c = 'abcdefghjkmnpqrstuvwxyz23456789ABCDEFGHJKMNPQRSTUVWXYZ';
    var s = '';
    for (var i=0;i<10;i++) s += c.charAt(Math.floor(Math.random()*c.length));
    return s;
  }

  // ── Load list ──
  window.apaLoad = async function(){
    try {
      var r = await fetch(API + '?action=list', {credentials:'include'});
      var d = await r.json();
      if (!d.ok) throw new Error(d.error || 'Failed');
      ALL = d.accounts || [];
      apaRender();
    } catch(e) {
      $('apaTBody').innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:#f87171">' + esc(e.message) + '</td></tr>';
    }
  };

  function apaRender(){
    var q = $('apaFilter').value.trim().toLowerCase();
    var rows = ALL.filter(function(a){
      if (!q) return true;
      return (a.stage_name||'').toLowerCase().indexOf(q) >= 0
        || (a.first_name||'').toLowerCase().indexOf(q) >= 0
        || (a.last_name||'').toLowerCase().indexOf(q) >= 0
        || (a.email||'').toLowerCase().indexOf(q) >= 0;
    });

    if (!rows.length) {
      $('apaTBody').innerHTML = '<tr><td colspan="6" style="padding:30px;text-align:center;color:#8a8fa8">' + (ALL.length ? 'No matches.' : 'No accounts yet. Click "+ Add Performer".') + '</td></tr>';
      return;
    }

    $('apaTBody').innerHTML = rows.map(function(a){
      var realName = ((a.first_name || '') + ' ' + (a.last_name || '')).trim();
      var activeBadge = a.active == 1
        ? '<span style="background:rgba(34,197,94,.15);color:#22c55e;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700">Active</span>'
        : '<span style="background:rgba(239,68,68,.15);color:#ef4444;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700">Inactive</span>';
      return '<tr style="border-bottom:1px solid #1e2330">'
        +   '<td style="padding:10px 12px;font-weight:600;color:#e8eaf0">' + esc(a.stage_name || '—') + '</td>'
        +   '<td style="padding:10px 12px;color:#e8eaf0">' + esc(realName || '—') + '</td>'
        +   '<td style="padding:10px 12px;color:#8a8fa8;font-size:12px">' + esc(a.email) + '</td>'
        +   '<td style="padding:10px 12px;color:#8a8fa8;font-size:12px">' + fmtDate(a.last_login_at) + '</td>'
        +   '<td style="padding:10px 12px;text-align:center">' + activeBadge + '</td>'
        +   '<td style="padding:10px 12px;text-align:right;white-space:nowrap">'
        +     '<button onclick="apaEdit(' + a.id + ')" style="background:transparent;border:1px solid #2a2f3e;color:#e8eaf0;border-radius:5px;padding:4px 9px;font-size:11px;cursor:pointer;margin-right:4px">Edit</button>'
        +     '<button onclick="apaOpenReset(' + a.id + ')" style="background:transparent;border:1px solid #d4a830;color:#d4a830;border-radius:5px;padding:4px 9px;font-size:11px;cursor:pointer;margin-right:4px">Reset PW</button>'
        +     '<button onclick="apaDelete(' + a.id + ')" style="background:transparent;border:1px solid #ef4444;color:#ef4444;border-radius:5px;padding:4px 9px;font-size:11px;cursor:pointer">Delete</button>'
        +   '</td>'
        + '</tr>';
    }).join('');
  }

  // ── Add ──
  window.apaOpenNew = function(){
    $('apaModalTitle').textContent = 'Add Performer';
    $('apaId').value = '';
    $('apaStage').value = '';
    $('apaFirst').value = '';
    $('apaLast').value = '';
    $('apaEmail').value = '';
    $('apaPassword').value = genPw();
    $('apaActive').checked = true;
    $('apaNotes').value = '';
    $('apaPwLabel').textContent = '*';
    $('apaPwHint').textContent = 'Auto-generated. Edit if you want a specific password.';
    $('apaModalErr').textContent = '';
    $('apaModal').style.display = 'flex';
    setTimeout(function(){ $('apaStage').focus(); }, 50);
  };

  // ── Edit ──
  window.apaEdit = function(id){
    var a = ALL.find(function(x){ return x.id === id; });
    if (!a) return;
    $('apaModalTitle').textContent = 'Edit Performer';
    $('apaId').value = a.id;
    $('apaStage').value = a.stage_name || '';
    $('apaFirst').value = a.first_name || '';
    $('apaLast').value  = a.last_name  || '';
    $('apaEmail').value = a.email || '';
    $('apaPassword').value = '';
    $('apaActive').checked = a.active == 1;
    $('apaNotes').value = a.notes || '';
    $('apaPwLabel').textContent = '';
    $('apaPwHint').textContent = 'Leave blank to keep the existing password. Type a new one to replace it.';
    $('apaModalErr').textContent = '';
    $('apaModal').style.display = 'flex';
  };

  window.apaCloseModal = function(){ $('apaModal').style.display = 'none'; };

  // ── Save ──
  window.apaSave = async function(){
    var payload = {
      id:         parseInt($('apaId').value || '0', 10) || 0,
      stage_name: $('apaStage').value.trim(),
      first_name: $('apaFirst').value.trim(),
      last_name:  $('apaLast').value.trim(),
      email:      $('apaEmail').value.trim().toLowerCase(),
      password:   $('apaPassword').value, // exact
      active:     $('apaActive').checked,
      notes:      $('apaNotes').value.trim()
    };
    if (!payload.email) { $('apaModalErr').textContent = 'Email is required.'; return; }
    if (!payload.stage_name && !payload.first_name && !payload.last_name) {
      $('apaModalErr').textContent = 'Enter a stage name or real name.'; return;
    }
    if (payload.id === 0 && payload.password.length < 4) {
      $('apaModalErr').textContent = 'Password required for new accounts (min 4 chars).'; return;
    }

    var btn = $('apaSaveBtn'); btn.disabled = true; btn.textContent = 'Saving...';
    try {
      var r = await fetch(API + '?action=save', {
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });
      var d = await r.json();
      if (d.ok) { apaCloseModal(); apaLoad(); }
      else { $('apaModalErr').textContent = d.error || 'Save failed'; }
    } catch(e) { $('apaModalErr').textContent = 'Network: ' + e.message; }
    btn.disabled = false; btn.textContent = 'Save';
  };

  // ── Reset password ──
  window.apaOpenReset = function(id){
    var a = ALL.find(function(x){ return x.id === id; });
    if (!a) return;
    $('apaResetId').value = id;
    $('apaResetWho').textContent = (a.stage_name || a.first_name || a.email);
    $('apaResetPw').value = genPw();
    $('apaResetErr').textContent = '';
    $('apaResetModal').style.display = 'flex';
  };
  window.apaCloseResetModal = function(){ $('apaResetModal').style.display = 'none'; };
  window.apaDoReset = async function(){
    var id = parseInt($('apaResetId').value, 10);
    var pw = $('apaResetPw').value;
    if (pw.length < 4) { $('apaResetErr').textContent = 'Min 4 chars.'; return; }
    var btn = $('apaResetBtn'); btn.disabled = true; btn.textContent = 'Setting...';
    try {
      var r = await fetch(API + '?action=reset_password', {
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({id:id, password:pw})
      });
      var d = await r.json();
      if (d.ok) {
        apaCloseResetModal();
        alert('Password set. Share it securely with the performer:\n\n' + pw);
        apaLoad();
      } else { $('apaResetErr').textContent = d.error || 'Failed'; }
    } catch(e) { $('apaResetErr').textContent = 'Network: ' + e.message; }
    btn.disabled = false; btn.textContent = 'Set Password';
  };

  // ── Delete ──
  window.apaDelete = async function(id){
    var a = ALL.find(function(x){ return x.id === id; });
    if (!a) return;
    if (!confirm('Delete account for ' + (a.stage_name || a.email) + '?\n\nThis removes them from this table AND from the registration table. This cannot be undone.')) return;
    try {
      var r = await fetch(API + '?action=delete', {
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({id:id})
      });
      var d = await r.json();
      if (d.ok) apaLoad();
      else alert(d.error || 'Delete failed');
    } catch(e) { alert('Network error'); }
  };

  // ── Wire events ──
  $('apaNewBtn').onclick = apaOpenNew;
  $('apaFilter').oninput = apaRender;
  $('apaGenBtn').onclick = function(){ $('apaResetPw').value = genPw(); };

  setTimeout(apaLoad, 100);
})();
</script>

