// ═══ Voice Functions ═══
window.loadCallStats = async function() {
    try {
        const r = await fetch(VOICE_API+'?action=stats');
        const d = await r.json();
        document.getElementById('csTotal').textContent = d.total||0;
        document.getElementById('csToday').textContent = d.today||0;
        document.getElementById('csMinutes').textContent = d.total_minutes||0;
    } catch(e) {}
};

window.loadCallHistory = async function() {
    try {
        const r = await fetch(VOICE_API+'?action=history&limit=50');
        const calls = await r.json();
        const body = document.getElementById('callBody');
        if(!calls.length) { body.innerHTML = '<tr><td colspan="7" class="loading">No calls yet</td></tr>'; return; }
        body.innerHTML = calls.map(c => {
            const dir = c.direction==='inbound' ? '<span style="color:#60a5fa">Inbound</span>' : '<span style="color:#4ade80">Outbound</span>';
            const dur = c.duration>0 ? Math.floor(c.duration/60)+'m '+c.duration%60+'s' : '-';
            const rec = c.recording_url ? '<a href="'+c.recording_url+'" target="_blank" style="color:#d4a830;font-size:11px">Play</a>' : '-';
            const date = new Date(c.created_at).toLocaleString();
            return '<tr><td>'+dir+'</td><td>'+escH(c.phone)+'</td><td>'+escH(c.performer_email||'-')+'</td>' +
                '<td>'+escH(c.status)+'</td><td>'+dur+'</td><td>'+rec+'</td><td style="font-size:11px">'+date+'</td></tr>';
        }).join('');
    } catch(e) {
        document.getElementById('callBody').innerHTML = '<tr><td colspan="7" class="loading">Error loading</td></tr>';
    }
};

window.makeCall = async function() {
    const to = document.getElementById('dialNumber').value.trim();
    const admin = document.getElementById('dialAdmin').value.trim();
    if(!to) { alert('Enter a phone number'); return; }
    document.getElementById('callStatus').textContent = 'Calling...';
    try {
        const r = await fetch(VOICE_API+'?action=call', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({to:to, admin_phone:admin||undefined})
        });
        const d = await r.json();
        if(d.success) {
            document.getElementById('callStatus').textContent = 'Call initiated! SID: '+d.sid;
            document.getElementById('callStatus').style.color = '#4ade80';
            loadCallStats(); loadCallHistory();
        } else {
            document.getElementById('callStatus').textContent = 'Error: '+(d.error||'failed');
            document.getElementById('callStatus').style.color = '#f87171';
        }
    } catch(e) {
        document.getElementById('callStatus').textContent = 'Error: '+e.message;
        document.getElementById('callStatus').style.color = '#f87171';
    }
};

window.sendBulkSms = async function() {
    const msg = document.getElementById('bulkMsg').value.trim();
    if(!msg) { alert('Enter a message'); return; }
    const target = document.getElementById('bulkTarget').value;
    document.getElementById('bulkStatus').textContent = 'Fetching performers...';
    try {
        const pr = await fetch('/api/performers.php?action=list');
        const performers = await pr.json();
        let emails = performers.filter(p => p.phone).map(p => p.email);
        if(target==='active') emails = performers.filter(p => p.phone && p.status==='Active').map(p => p.email);
        if(!emails.length) { document.getElementById('bulkStatus').textContent = 'No performers with phone numbers'; return; }
        if(!confirm('Send SMS to '+emails.length+' performers?')) { document.getElementById('bulkStatus').textContent = ''; return; }
        document.getElementById('bulkStatus').textContent = 'Sending to '+emails.length+' performers...';
        const r = await fetch(SMS_API+'?action=send_bulk', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({body:msg, emails:emails})
        });
        const d = await r.json();
        document.getElementById('bulkStatus').textContent = 'Sent: '+d.sent+' | Failed: '+d.failed;
        document.getElementById('bulkStatus').style.color = '#4ade80';
    } catch(e) {
        document.getElementById('bulkStatus').textContent = 'Error: '+e.message;
        document.getElementById('bulkStatus').style.color = '#f87171';
    }
};

function escH(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
</script>
<script>
// ═══ Live Chat Admin JS ═══
const CHAT_API = '/api/chat.php';
let currentChatSession = '';
let chatPollInterval = null;
let chatFilterStatus = 'active';
let chatLastMsgId = 0;
let chatTypingTimer = null;

// Agent login email from session
const agentEmail = sessionStorage.getItem('userEmail') || localStorage.getItem('userEmail') || 'admin';
const agentName = sessionStorage.getItem('userName') || 'Admin';

// ── Toggle agent online/offline ──
window.toggleAgentOnline = function() {
    const on = document.getElementById('agentOnlineToggle').checked;
    fetch(CHAT_API+'?action=set_status', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({email:agentEmail, name:agentName, status: on?'online':'offline'})
    });
    document.getElementById('agentStatusText').textContent = on ? 'Online' : 'Go Online';
    document.getElementById('agentStatusText').style.color = on ? '#4ade80' : '#c0c4d0';
};

// ── Filter active/closed/all ──
window.chatFilterView = function(status) {
    chatFilterStatus = status;
    document.querySelectorAll('#tab-livechat .tf-btn').forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    loadChatSessions();
};

// ── Load chat sessions (DISABLED — replaced by new chat.php logic in tab-livechat block) ──
window.loadChatSessions = async function() { /* no-op — legacy stub */ };

// ── Load chat thread ──
window.loadChatThread = async function(sessionId) {
    currentChatSession = sessionId;
    chatLastMsgId = 0;
    document.querySelectorAll('#chatSessionList .sms-contact').forEach(c => c.classList.remove('active'));
    if(event && event.target) event.target.closest('.sms-contact')?.classList.add('active');

    try {
        const r = await fetch(CHAT_API+'?action=session_messages&session_id='+sessionId);
        const d = await r.json();
        const session = d.session;
        const msgs = d.messages || [];

        document.getElementById('chatThreadName').textContent = session.visitor_name || 'Visitor';
        document.getElementById('chatThreadEmail').textContent = session.visitor_email || '';

        const container = document.getElementById('chatMessages');
        if(!msgs.length) { container.innerHTML = '<div class="sms-empty">No messages</div>'; return; }

        container.innerHTML = msgs.map(m => {
            chatLastMsgId = Math.max(chatLastMsgId, m.id);
            let cls = 'in';
            if(m.sender_type==='agent') cls = 'out';
            if(m.sender_type==='system') cls = 'in';
            const style = m.sender_type==='system' ? 'background:rgba(212,168,48,0.08);color:#d4a830;border:1px solid rgba(212,168,48,0.15);font-style:italic' : '';
            const time = new Date(m.created_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
            const label = m.sender_type==='agent' ? '<div style="font-size:10px;opacity:.6;margin-bottom:2px">'+escH(m.sender_name)+'</div>' : '';
            return '<div class="sms-msg '+cls+'" style="'+style+'">'+label+escH(m.message)+'<div class="sms-time">'+time+'</div></div>';
        }).join('');
        container.scrollTop = container.scrollHeight;

        // Show compose if session is active
        const isActive = session.status === 'active';
        document.getElementById('chatCompose').style.display = isActive ? 'flex' : 'none';
        document.getElementById('chatCloseBtn').style.display = isActive ? '' : 'none';

        // Refresh session list to clear unread badges
        loadChatSessions();
    } catch(e) {
        document.getElementById('chatMessages').innerHTML = '<div class="sms-empty">Error loading</div>';
    }
};

// ── Send agent reply ──
window.chatSendReply = async function() {
    if(!currentChatSession) return;
    const input = document.getElementById('chatReplyInput');
    const msg = input.value.trim();
    if(!msg) return;
    input.value = '';

    // Optimistic add
    const container = document.getElementById('chatMessages');
    container.innerHTML += '<div class="sms-msg out">'+escH(msg)+'<div class="sms-time">Sending...</div></div>';
    container.scrollTop = container.scrollHeight;

    try {
        await fetch(CHAT_API+'?action=agent_reply', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({session_id:currentChatSession, message:msg, agent_name:agentName})
        });
        // Stop typing indicator
        fetch(CHAT_API+'?action=agent_typing', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({session_id:currentChatSession, typing:false})
        });
        loadChatThread(currentChatSession);
    } catch(e) { alert('Send failed'); }
};

// ── Close chat session ──
window.closeChatSession = async function() {
    if(!currentChatSession) return;
    if(!confirm('Close this chat?')) return;
    try {
        await fetch(CHAT_API+'?action=close_session', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({session_id:currentChatSession})
        });
        loadChatThread(currentChatSession);
        loadChatSessions();
    } catch(e) { alert('Error closing chat'); }
};

// ── Agent typing indicator ──
window.chatAgentTyping = function() {
    if(!currentChatSession) return;
    fetch(CHAT_API+'?action=agent_typing', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({session_id:currentChatSession, typing:true})
    });
