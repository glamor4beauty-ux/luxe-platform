let sortField = 'created_at';
let sortDir = 'desc';

// ── Search debounce ──
let searchTimer;
function debounceSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => loadPerformers($('searchInput').value), 300);
}
