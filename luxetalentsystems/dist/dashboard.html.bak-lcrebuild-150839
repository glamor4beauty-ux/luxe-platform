                <button class="act-btn act-edit" onclick="viewKBFile(${f.id})">View</button>
                <button class="act-btn act-del" onclick="deleteKBFile(${f.id},'${esc(f.title)}')">Delete</button>
            </td>
        </tr>`;
    }).join('');
}

function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024*1024) return (bytes/1024).toFixed(0) + ' KB';
    return (bytes/(1024*1024)).toFixed(1) + ' MB';
}

