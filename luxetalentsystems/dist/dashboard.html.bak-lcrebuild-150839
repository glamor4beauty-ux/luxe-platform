                <button class="act-btn act-edit" onclick="editPerformer('${esc(p.email)}')">Edit</button>
                <button class="act-btn act-del" onclick="deletePerformer('${esc(p.email)}','${esc(p.stage_name||realName)}')">Delete</button>
            </td>
        </tr>`;
    }).join('');
}

// ── CSV Import ──
window.importCSV = async function(input) {
    if (!input.files[0]) return;
    const text = await input.files[0].text();
    const lines = text.trim().split('\n');
    if (lines.length < 2) { toast('CSV must have header + at least one row', 'err'); return; }
    const headers = lines[0].split(',').map(h => h.trim().toLowerCase().replace(/[^a-z_]/g,''));

    const map = {};
    headers.forEach((h, i) => {
        if (h.includes('email')) map.email = i;
        else if (h.includes('first') && h.includes('name')) map.first_name = i;
        else if (h === 'first_name' || h === 'firstname') map.first_name = i;
        else if (h.includes('last') && h.includes('name')) map.last_name = i;
        else if (h === 'last_name' || h === 'lastname') map.last_name = i;
        else if (h.includes('middle')) map.middle_name = i;
        else if (h.includes('stage')) map.stage_name = i;
        else if (h.includes('phone')) map.phone = i;
        else if (h.includes('platform')) map.platform = i;
        else if (h.includes('recruiter')) map.recruiter = i;
        else if (h.includes('studio') && h.includes('fee')) map.studio_fee = i;
        else if (h.includes('profile_photo') || h.includes('photo_url')) map.profile_photo_url = i;
        else if (h.includes('id_front')) map.id_front_url = i;
        else if (h.includes('id_back')) map.id_back_url = i;
        else if (h.includes('country')) map.country = i;
        else if (h.includes('city')) map.city = i;
        else if (h.includes('state')) map.state = i;
        else if (h.includes('street') || h.includes('address')) map.street_address = i;
        else if (h.includes('zip') || h.includes('postal')) map.zip_code = i;
        else if (h.includes('dob') || h.includes('birth')) map.date_of_birth = i;
        else if (h.includes('height')) map.height = i;
        else if (h.includes('weight')) map.weight = i;
        else if (h.includes('ethnicity')) map.ethnicity = i;
        else if (h.includes('orientation')) map.orientation = i;
        else if (h.includes('build')) map.build = i;
        else if (h.includes('eye')) map.eye_color = i;
        else if (h.includes('hair_color') || h === 'haircolor') map.hair_color = i;
        else if (h.includes('hair_length') || h === 'hairlength') map.hair_length = i;
        else if (h.includes('about')) map.about_me = i;
        else if (h.includes('language')) map.primary_language = i;
        else if (h.includes('password')) map.password = i;
    });

    if (map.email === undefined) { toast('CSV must have an "email" column', 'err'); return; }

    let added = 0, failed = 0, skipped = 0;
    const hasPhotos = map.profile_photo_url !== undefined || map.id_front_url !== undefined;
    toast('Importing ' + (lines.length - 1) + ' rows' + (hasPhotos ? ' (downloading photos — may take time)...' : '...'));

    for (let i = 1; i < lines.length; i++) {
        const cols = parseCSVLine(lines[i]);
        if (!cols[map.email]) continue;
        const payload = {};
        for (const [field, idx] of Object.entries(map)) {
            if (cols[idx] !== undefined && cols[idx] !== '') payload[field] = cols[idx].trim();
        }
        try {
            const r = await fetch(API + '/performers.php?action=csv_import', {credentials:'include', 
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify(payload)
            });
            const d = await r.json();
            if (d.success) added++;
            else if (d.error && d.error.includes('already exists')) skipped++;
            else failed++;
        } catch(e) { failed++; }
    }
    toast('Import: ' + added + ' added, ' + skipped + ' skipped, ' + failed + ' failed');
    input.value = '';
    loadPerformers();
};

function parseCSVLine(line) {
    const result = [];
    let current = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') { inQuotes = !inQuotes; continue; }
        if (ch === ',' && !inQuotes) { result.push(current.trim()); current = ''; continue; }
        current += ch;
    }
    result.push(current.trim());
    return result;
}

function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

