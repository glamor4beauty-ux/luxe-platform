// ── Toast ──
function toast(msg, type) {
    const t = $('toast');
    t.textContent = msg;
    t.className = 'toast show ' + (type || 'ok');
    setTimeout(() => t.classList.remove('show'), 3000);
}

// ── Sorting state ──
