function renderKBTable(rows) {
    const body = $('kbBody');
    if (!rows.length) { body.innerHTML = '<tr><td colspan="7" class="empty">No files found</td></tr>'; return; }
    body.innerHTML = rows.map(f => {
        const size = f.file_size ? formatSize(f.file_size) : '—';
        const date = f.created_at ? f.created_at.substring(0, 10) : '—';
        const typeClass = f.file_type || 'txt';
        return `<tr>
            <td><a class="kb-title-link" onclick="viewKBFile(${f.id})">${esc(f.title)}</a></td>
            <td>${esc(f.category || '')}</td>
            <td>${esc(f.subcategory || '—')}</td>
            <td><span class="kb-type ${typeClass}">${typeClass}</span></td>
            <td style="white-space:nowrap">${size}</td>
            <td style="white-space:nowrap">${date}</td>
