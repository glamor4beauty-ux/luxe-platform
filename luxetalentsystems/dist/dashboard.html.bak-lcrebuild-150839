// ═══ SMS Functions ═══
window.loadSmsContacts = async function() {
    try {
        const r = await fetch(SMS_API+'?action=history&limit=200');
        const msgs = await r.json();
        const contacts = {};
        msgs.forEach(m => {
            if(!contacts[m.phone]) contacts[m.phone] = {phone:m.phone, email:m.performer_email, messages:[], last:m.created_at};
            contacts[m.phone].messages.push(m);
        });
        const list = document.getElementById('smsContactList');
        const phones = Object.keys(contacts).sort((a,b) => contacts[b].last.localeCompare(contacts[a].last));
        if(!phones.length) { list.innerHTML = '<div class="sms-empty">No SMS conversations yet</div>'; return; }
        list.innerHTML = phones.map(p => {
            const c = contacts[p];
            const last = c.messages[0];
            const name = c.email || p;
            const preview = last.body.substring(0,40) + (last.body.length>40?'...':'');
            const time = new Date(last.created_at).toLocaleDateString();
            return '<div class="sms-contact'+(p===currentSmsPhone?' active':'')+'" onclick="loadSmsThread(\''+p+'\')">' +
                '<div class="sc-time">'+time+'</div><div class="sc-name">'+escH(name)+'</div>' +
                '<div class="sc-phone">'+escH(p)+'</div><div class="sc-preview">'+escH(preview)+'</div></div>';
        }).join('');
    } catch(e) {
        document.getElementById('smsContactList').innerHTML = '<div class="sms-empty">Failed to load</div>';
    }
};

window.loadSmsThread = async function(phone) {
    currentSmsPhone = phone;
    document.querySelectorAll('.sms-contact').forEach(c => c.classList.remove('active'));
    event?.target?.closest?.('.sms-contact')?.classList.add('active');
    document.getElementById('smsCompose').style.display = 'flex';
    try {
        const r = await fetch(SMS_API+'?action=conversation&phone='+encodeURIComponent(phone));
        const d = await r.json();
        const perf = d.performer;
        document.getElementById('smsThreadName').textContent = perf ? (perf.firstName+' '+perf.lastName) : phone;
        document.getElementById('smsThreadPhone').textContent = perf ? phone : '';
        const msgs = d.messages || [];
        const container = document.getElementById('smsMessages');
        if(!msgs.length) { container.innerHTML = '<div class="sms-empty">No messages</div>'; return; }
        container.innerHTML = msgs.map(m => {
            const cls = m.direction==='outbound' ? 'out' : 'in';
            const time = new Date(m.created_at).toLocaleString();
            return '<div class="sms-msg '+cls+'">'+escH(m.body)+'<div class="sms-time">'+time+'</div></div>';
        }).join('');
        container.scrollTop = container.scrollHeight;
    } catch(e) {
        document.getElementById('smsMessages').innerHTML = '<div class="sms-empty">Error loading</div>';
    }
};

window.smsSendReply = async function() {
    if(!currentSmsPhone) return;
    const input = document.getElementById('smsReplyInput');
    const body = input.value.trim();
    if(!body) return;
    input.value = '';
    // Optimistic add
    const container = document.getElementById('smsMessages');
    container.innerHTML += '<div class="sms-msg out">'+escH(body)+'<div class="sms-time">Sending...</div></div>';
    container.scrollTop = container.scrollHeight;
    try {
        await fetch(SMS_API+'?action=send', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({to:currentSmsPhone, body:body})
        });
        loadSmsThread(currentSmsPhone);
    } catch(e) { alert('Send failed: '+e.message); }
};

