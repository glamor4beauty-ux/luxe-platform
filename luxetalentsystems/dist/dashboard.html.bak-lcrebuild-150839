// ── VIEW A: Hourly Grid (12hr, 30min slots) ──
function renderHourlyGrid() {
    const grid = $('hourlyGrid');
    const empty = $('hourlyEmpty');
    if (!dayData.length) { grid.innerHTML = ''; empty.style.display = 'block'; return; }
    empty.style.display = 'none';

    // Time slots: 12:00 AM to 11:30 PM (48 slots)
    const slots = [];
    for (let h = 0; h < 24; h++) {
        for (let m = 0; m < 60; m += 30) {
            const hr12 = h === 0 ? 12 : (h > 12 ? h - 12 : h);
            const ampm = h < 12 ? 'AM' : 'PM';
            const label = hr12 + ':' + String(m).padStart(2,'0') + ampm;
            const mins = h * 60 + m;
            slots.push({ label, mins });
        }
    }

    // Header
    let html = '<div class="hg-header"><div class="hg-label">Stage Name</div>';
    // Show every other slot label to save space
    slots.forEach((s, i) => {
        html += `<div class="hg-time">${i % 2 === 0 ? s.label : ''}</div>`;
    });
    html += '</div>';

    // Rows per performer
    dayData.forEach(p => {
        const stMins = timeToMins(p.start_time);
        const etMins = timeToMins(p.end_time);
        html += '<div class="hg-row">';
        html += `<div class="hg-name">${esc(p.stage_name || p.last_name)}</div>`;
        slots.forEach((s, i) => {
            let filled = false;
            if (etMins > stMins) {
                filled = s.mins >= stMins && s.mins < etMins;
            } else { // overnight
                filled = s.mins >= stMins || s.mins < etMins;
            }
            const isStart = s.mins === stMins;
            const isEnd = (i + 1 < slots.length) && slots[i+1].mins === etMins;
            let cls = 'hg-cell';
            if (filled) cls += ' filled';
            if (filled && isStart) cls += ' filled-start';
            if (filled && isEnd) cls += ' filled-end';
            html += `<div class="${cls}"></div>`;
        });
        html += '</div>';
    });

    grid.innerHTML = html;
}

function timeToMins(t) {
    if (!t) return 0;
    const parts = t.split(':');
    return parseInt(parts[0]) * 60 + parseInt(parts[1]);
}

function minsTo12hr(mins) {
    let h = Math.floor(mins / 60) % 24;
    const m = mins % 60;
    const ampm = h < 12 ? 'AM' : 'PM';
    if (h === 0) h = 12;
    else if (h > 12) h -= 12;
    return h + ':' + String(m).padStart(2,'0') + ' ' + ampm;
}

