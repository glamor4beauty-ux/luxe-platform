<div class="tab-content" id="tab-livechat">

  <!-- Header: persistent status switch + my name -->
  <div class="ad-lc-head">
    <div class="ad-lc-head-l">
      <h2 style="margin:0;font-size:18px;color:var(--gold)">Live Chat</h2>
      <div id="adLcWhoami" style="font-size:11px;color:var(--muted);margin-top:2px"></div>
    </div>
    <div class="ad-lc-head-r">
      <span style="font-size:11px;color:var(--muted)">Status</span>
      <div class="ad-lc-switch" id="adLcSwitch" role="radiogroup" aria-label="Status">
        <button data-status="online"  class="ad-lc-sw-btn">Online</button>
        <button data-status="away"    class="ad-lc-sw-btn">Away</button>
        <button data-status="offline" class="ad-lc-sw-btn">Offline</button>
      </div>
    </div>
  </div>

  <!-- Body: 2-column split (left = sessions+agents stack, right = thread) -->
  <div class="ad-lc-grid">

    <!-- LEFT COLUMN -->
    <div class="ad-lc-left">
      <!-- Top half: sessions -->
      <div class="ad-lc-pane">
        <div class="ad-lc-pane-head">
          <span>Active Chats</span>
          <span id="adLcSessCount" style="font-size:10px;color:var(--muted)"></span>
        </div>
        <div class="ad-lc-list" id="adLcSessList"><div class="ad-lc-empty">No active chats</div></div>
      </div>
      <!-- Bottom half: agents -->
      <div class="ad-lc-pane">
        <div class="ad-lc-pane-head">
          <span>Team Online</span>
          <span id="adLcAgentCount" style="font-size:10px;color:var(--muted)"></span>
        </div>
        <div class="ad-lc-list" id="adLcAgentList"><div class="ad-lc-empty">Loading...</div></div>
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="ad-lc-right">
      <div class="ad-lc-tabs">
        <button class="ad-lc-tab active" data-view="thread">Chat</button>
        <button class="ad-lc-tab" data-view="offline">
          Offline Messages
          <span id="adLcOfflineBadge" class="ad-lc-tab-badge" style="display:none">0</span>
        </button>
      </div>

      <!-- THREAD VIEW -->
      <div class="ad-lc-view" id="adLcViewThread">
        <div class="ad-lc-thread-head" id="adLcThreadHead">
          <div style="color:var(--muted);font-size:13px">Select a chat to view</div>
        </div>
        <div class="chat-msgs" id="adLcThreadMsgs" style="flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px"></div>
        <div class="chat-typing" id="adLcThreadTyping" style="display:none">Visitor is typing...</div>
        <div class="ad-lc-thread-input" id="adLcThreadInput" style="display:none">
          <textarea id="adLcReplyInput" rows="4" placeholder="Type your reply..." style="min-height:88px;max-height:120px;line-height:1.4"></textarea>
          <div style="display:flex;gap:8px;margin-top:8px">
            <button class="ad-lc-btn primary" id="adLcReplyBtn">Send</button>
            <button class="ad-lc-btn" id="adLcCloseBtn">Close Chat</button>
          </div>
        </div>
      </div>

      <!-- OFFLINE INBOX VIEW -->
      <div class="ad-lc-view" id="adLcViewOffline" style="display:none">
        <div id="adLcOfflineList" style="flex:1;overflow-y:auto;padding:8px">
          <div class="ad-lc-empty">Loading...</div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
