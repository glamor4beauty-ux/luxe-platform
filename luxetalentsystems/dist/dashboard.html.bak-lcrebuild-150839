        // Show photos if available
        const photos = $('editPhotos');
        let html = '';
        const baseUrl = API.replace('/api','');
        if (p.profile_photo) {
            html += '<div class="photo-label">Profile Photos</div>';
            try {
                const arr = JSON.parse(p.profile_photo);
                arr.forEach(u => html += `<img src="${baseUrl}/${u}" alt="profile" onclick="window.open('${baseUrl}/${u}','_blank')"/>`);
            } catch(e) {
                if (p.profile_photo) html += `<img src="${baseUrl}/${p.profile_photo}" alt="profile" onclick="window.open('${baseUrl}/${p.profile_photo}','_blank')"/>`;
            }
        }
        if (p.id_front) {
            html += '<div class="photo-label">ID Front</div>';
            html += `<img src="${baseUrl}/${p.id_front}" alt="id front" onclick="window.open('${baseUrl}/${p.id_front}','_blank')"/>`;
        }
        if (p.id_back) {
            html += '<div class="photo-label">ID Back</div>';
            html += `<img src="${baseUrl}/${p.id_back}" alt="id back" onclick="window.open('${baseUrl}/${p.id_back}','_blank')"/>`;
        }
        if (p.face_and_id) {
            html += '<div class="photo-label">Face + ID</div>';
            html += `<img src="${baseUrl}/${p.face_and_id}" alt="face+id" onclick="window.open('${baseUrl}/${p.face_and_id}','_blank')"/>`;
        }
        if (p.nude_photos) {
            html += '<div class="photo-label">Additional Photos</div>';
            try {
                const arr = JSON.parse(p.nude_photos);
                arr.forEach(u => html += `<img src="${baseUrl}/${u}" alt="additional" onclick="window.open('${baseUrl}/${u}','_blank')"/>`);
            } catch(e) {}
        }
        if (p.signature_path) {
            html += '<div class="photo-label">Signature</div>';
            html += `<img src="${baseUrl}/${p.signature_path}" alt="signature" style="max-height:40px"/>`;
        }
        photos.innerHTML = html || '<p style="color:#4a4f5e;font-size:12px">No photos uploaded</p>';
    } catch(e) {
        $('editMsg').textContent = 'Failed to load: ' + e.message;
        $('editMsg').style.color = '#f87171';
    }
};

