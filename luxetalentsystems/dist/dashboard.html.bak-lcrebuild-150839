async function loadDashChart() {
    try {
        var r = await fetch(API+'/stripchat.php?action=monthly_totals', {credentials:'include'});
        var d = await r.json();
        var months = d.months || [];
        var canvas = document.getElementById('dashChart');
        var ctx = canvas.getContext('2d');
        var W = canvas.width = canvas.offsetWidth;
        var H = canvas.height = 220;
        ctx.clearRect(0,0,W,H);
        
        var labels = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var data = new Array(12).fill(0);
        months.forEach(function(m){
            var parts = (m.month||'').split('-');
            if(parts.length===2) { var mi = parseInt(parts[1])-1; if(mi>=0&&mi<12) data[mi] = parseInt(m.total_earnings||0); }
        });
        
        var max = Math.max.apply(null, data) || 1;
        var barW = (W-60) / 12;
        var chartH = H - 40;
        
        ctx.font = '10px sans-serif';
        ctx.fillStyle = '#6a6f88';
        ctx.textAlign = 'center';
        
        for(var i=0;i<12;i++){
            var x = 30 + i*barW + barW/2;
            var barH = (data[i]/max)*chartH;
            var y = chartH - barH + 10;
            
            // Bar
            ctx.fillStyle = data[i] > 0 ? '#d4a830' : '#2a2f3e';
            ctx.fillRect(x-barW/3, y, barW*2/3, barH);
            
            // Label
            ctx.fillStyle = '#6a6f88';
            ctx.fillText(labels[i], x, H-5);
            
            // Value on top
            if(data[i]>0) {
                ctx.fillStyle = '#e8eaf0';
                ctx.fillText('$'+data[i].toLocaleString(), x, y-5);
            }
        }
    } catch(e) {}
}

