<script>
// ═══ Dialpad ═══
let dialStr='';
window.dialPress=function(k){dialStr+=k;document.getElementById('dialDisplay').textContent=formatPhone(dialStr);};
window.dialBackspace=function(){dialStr=dialStr.slice(0,-1);document.getElementById('dialDisplay').textContent=formatPhone(dialStr);};
window.dialClear=function(){dialStr='';document.getElementById('dialDisplay').textContent='';};
function formatPhone(s){if(!s)return '';if(s.length<=3)return s;if(s.length<=6)return '('+s.substring(0,3)+') '+s.substring(3);return '('+s.substring(0,3)+') '+s.substring(3,6)+'-'+s.substring(6,10);}
window.dialCall=function(){
    var num=dialStr.replace(/\D/g,'');
    if(num.length<10){document.getElementById('callStatus').textContent='Enter a valid number';document.getElementById('callStatus').style.color='#f87171';return;}
    if(!num.startsWith('1')&&num.length===10)num='1'+num;
    document.getElementById('dialNumber')||null;
    var admin=document.getElementById('dialAdmin').value.trim();
    var from=document.getElementById('dialFrom').value;
    if(!admin){document.getElementById('callStatus').textContent='Enter your phone to connect';document.getElementById('callStatus').style.color='#f87171';return;}
    document.getElementById('callStatus').textContent='Calling...';document.getElementById('callStatus').style.color='#4ade80';
    makeCallDirect('+'+num,admin,from);
};
async function makeCallDirect(to,admin,from){
    try{
        var r=await fetch(API+'/sms.php?action=call',{credentials:'include', method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({to:to,admin_phone:admin,from:from||''})});
        var d=await r.json();
        if(d.success){document.getElementById('callStatus').textContent='Call initiated! Answer your phone.';document.getElementById('callStatus').style.color='#4ade80';loadCallHistory();}
        else{document.getElementById('callStatus').textContent=d.error||'Failed';document.getElementById('callStatus').style.color='#f87171';}
    }catch(e){document.getElementById('callStatus').textContent='Error';document.getElementById('callStatus').style.color='#f87171';}
}
// Override old makeCall
window.makeCall=function(){dialCall();};
</script>
