function renderMonthGrid(counts) {
    const grid = $('monthGrid');
    const today = new Date().toISOString().split('T')[0];
    const first = new Date(schedYear, schedMonth, 1);
    const lastDay = new Date(schedYear, schedMonth + 1, 0).getDate();
    const startDow = first.getDay();

    let html = DAYS_SHORT.map(d => `<div class="mg-head">${d}</div>`).join('');

    // Pad previous month
    const prevLast = new Date(schedYear, schedMonth, 0).getDate();
    for (let i = startDow - 1; i >= 0; i--) {
        html += `<div class="mg-day other"><div class="day-num">${prevLast - i}</div></div>`;
    }

    // Current month days
    for (let d = 1; d <= lastDay; d++) {
        const dateStr = `${schedYear}-${String(schedMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const cnt = counts[dateStr] || 0;
        const isToday = dateStr === today ? ' today' : '';
        html += `<div class="mg-day${isToday}" onclick="schedClickDay('${dateStr}')">
            <div class="day-num">${d}</div>
            <div class="day-count ${cnt === 0 ? 'zero' : ''}">Scheduled: ${cnt}</div>
        </div>`;
    }

    // Pad next month
    const totalCells = startDow + lastDay;
    const remaining = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
    for (let i = 1; i <= remaining; i++) {
        html += `<div class="mg-day other"><div class="day-num">${i}</div></div>`;
    }

    grid.innerHTML = html;
}

