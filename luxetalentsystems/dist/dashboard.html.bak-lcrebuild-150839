// Import CSV
window.importLeadCSV = async function(input) {
    if (!input.files[0]) return;
    const text = await input.files[0].text();
    const lines = text.trim().split('\n');
    if (lines.length < 2) { toast('CSV must have header + data','err'); return; }
    const headers = lines[0].split(',').map(h => h.trim().toLowerCase().replace(/[^a-z_]/g,''));
    const nameIdx = headers.findIndex(h => h.includes('name') && !h.includes('stage'));
    const stageIdx = headers.findIndex(h => h.includes('stage'));
    const emailIdx = headers.indexOf('email');
    const phoneIdx = headers.findIndex(h => h.includes('phone'));
    const igIdx = headers.findIndex(h => h.includes('instagram') || h.includes('ig'));
    const countryIdx = headers.findIndex(h => h.includes('country'));
    const notesIdx = headers.findIndex(h => h.includes('notes'));
    if (nameIdx === -1) { toast('CSV must have a "name" or "full_name" column','err'); return; }

    let added = 0, failed = 0;
    toast('Importing ' + (lines.length-1) + ' leads...');
    for (let i = 1; i < lines.length; i++) {
        const cols = lines[i].split(',').map(c => c.trim().replace(/^"|"$/g,''));
        if (!cols[nameIdx]) continue;
        try {
            const r = await fetch(API + '/leads.php?action=add', {credentials:'include', 
                method:'POST', headers:{'Content-Type':'application/json'},
                body: JSON.stringify({
                    full_name: cols[nameIdx],
                    stage_name: stageIdx >= 0 ? cols[stageIdx] : '',
                    email: emailIdx >= 0 ? cols[emailIdx] : '',
                    phone: phoneIdx >= 0 ? cols[phoneIdx] : '',
                    instagram: igIdx >= 0 ? cols[igIdx] : '',
                    country: countryIdx >= 0 ? cols[countryIdx] : '',
                    notes: notesIdx >= 0 ? cols[notesIdx] : '',
                    recruiter: 'Clarence',
                })
            });
            const d = await r.json();
            if (d.success) added++; else failed++;
        } catch(e) { failed++; }
    }
    toast('Import: ' + added + ' added, ' + failed + ' failed');
    input.value = '';
    loadLeads();
};

