async function loadDashCalendar() {
    if(!document.getElementById('dashCalMonth')) return;
    var monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    document.getElementById('dashCalMonth').textContent = monthNames[dashCalMonth]+' '+dashCalYear;
    document.getElementById('dashCalDate').textContent = 'Day: '+new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
    
    // Load schedule entries for this month
    try {
        var r = await fetch(API+'/schedule.php?action=get_month&year='+dashCalYear+'&month='+(dashCalMonth+1, {credentials:'include'}));
        var d = await r.json();
        dashScheduleDates = {};
        if(Array.isArray(d)) d.forEach(function(s){ dashScheduleDates[s.start_date] = (dashScheduleDates[s.start_date]||0)+1; });
    } catch(e) { dashScheduleDates = {}; }
    
    renderDashCal();
}

function renderDashCal() {
    var grid = document.getElementById('dashCalGrid');
    var firstDay = new Date(dashCalYear, dashCalMonth, 1).getDay();
    var daysInMonth = new Date(dashCalYear, dashCalMonth+1, 0).getDate();
    var today = new Date();
    var todayStr = today.getFullYear()+'-'+String(today.getMonth()+1).padStart(2,'0')+'-'+String(today.getDate()).padStart(2,'0');
    
    var html = '';
    for(var i=0;i<firstDay;i++) html += '<div style="padding:4px;color:#2a2f3e">.</div>';
    for(var d=1;d<=daysInMonth;d++){
        var dateStr = dashCalYear+'-'+String(dashCalMonth+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
        var isToday = dateStr === todayStr;
        var hasSchedule = dashScheduleDates[dateStr];
        var bg = isToday ? 'background:#d4a830;color:#0e1117;border-radius:50%;font-weight:700' : hasSchedule ? 'background:rgba(74,222,128,.15);color:#4ade80;border-radius:4px' : 'color:#c0c4d0';
        var badge = hasSchedule ? '<div style="font-size:8px;color:#4ade80">Scheduled '+hasSchedule+'</div>' : '';
        html += '<div style="padding:4px;'+bg+';cursor:default" title="'+(hasSchedule?hasSchedule+' scheduled':'')+'">'+d+badge+'</div>';
    }
    grid.innerHTML = html;
}

