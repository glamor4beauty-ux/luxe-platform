{% comment %}
  boutique.liquid — the shop, inside a merchant's theme.

  A merchant drops this wherever they like in the theme editor. Their header
  and footer stay theirs; this sits between them showing our products, and a
  customer buys without leaving their site.

  The affiliate code is filled in automatically on install, so there is nothing
  for the merchant to configure and nothing to type wrongly. It is shown as a
  setting only so they can see it is there.
{% endcomment %}

<div class="mb-block"
     id="mb-block-{{ block.id }}"
     data-code="{{ block.settings.affiliate_code | escape }}"
     style="--mb-accent: {{ block.settings.accent }};
            --mb-radius: {{ block.settings.radius }}px;
            padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;">

  {% if block.settings.heading != blank %}
    <div class="mb-head">
      <h2>{{ block.settings.heading }}</h2>
      {% if block.settings.subheading != blank %}
        <p>{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.show_categories %}
    <div class="mb-cats" id="mb-cats-{{ block.id }}"></div>
  {% endif %}

  <div class="mb-goods" id="mb-goods-{{ block.id }}"></div>

  {% if block.settings.show_more %}
    <div class="mb-more" id="mb-more-{{ block.id }}" style="display:none">
      <button type="button" class="mb-btn-more">{{ block.settings.more_text }}</button>
    </div>
  {% endif %}

</div>

<style>
  /* Scoped to this block. It lands in somebody else's theme, and a rule that
     escapes ruins their page — so everything is prefixed and nothing touches
     an element we did not create.

     Typography is deliberately inherited: the shop should look like part of
     their site rather than a widget bolted on. */
  #mb-block-{{ block.id }} { max-width: 1200px; margin: 0 auto; }

  #mb-block-{{ block.id }} .mb-head { text-align: center; margin-bottom: 28px; }
  #mb-block-{{ block.id }} .mb-head h2 { margin: 0 0 8px; }
  #mb-block-{{ block.id }} .mb-head p { margin: 0; opacity: .7; }

  #mb-block-{{ block.id }} .mb-cats {
    display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;
    margin-bottom: 26px;
  }
  #mb-block-{{ block.id }} .mb-cat {
    background: none; border: 1px solid currentColor; opacity: .55;
    border-radius: var(--mb-radius); padding: 9px 18px; font: inherit;
    font-size: .9em; cursor: pointer; color: inherit;
  }
  #mb-block-{{ block.id }} .mb-cat:hover { opacity: .85; }
  #mb-block-{{ block.id }} .mb-cat.on {
    opacity: 1; border-color: var(--mb-accent); color: var(--mb-accent);
  }

  #mb-block-{{ block.id }} .mb-goods {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax({{ block.settings.min_width }}px, 1fr));
    gap: {{ block.settings.gap }}px;
  }
  @media (max-width: 600px) {
    #mb-block-{{ block.id }} .mb-goods { grid-template-columns: 1fr 1fr; gap: 14px; }
  }

  #mb-block-{{ block.id }} .mb-good { cursor: pointer; }
  #mb-block-{{ block.id }} .mb-shot {
    position: relative; aspect-ratio: 3/4; overflow: hidden;
    border-radius: var(--mb-radius); background: rgba(128,128,128,.08);
    margin-bottom: 10px;
  }
  #mb-block-{{ block.id }} .mb-shot img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .5s ease;
  }
  #mb-block-{{ block.id }} .mb-good:hover .mb-shot img { transform: scale(1.04); }
  #mb-block-{{ block.id }} .mb-good.out .mb-shot img { opacity: .45; }

  #mb-block-{{ block.id }} .mb-tag {
    position: absolute; top: 10px; left: 10px; font-size: .68em; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase; padding: 4px 10px;
    border-radius: calc(var(--mb-radius) / 2); background: rgba(0,0,0,.75); color: #fff;
  }
  #mb-block-{{ block.id }} .mb-tag.sale { background: var(--mb-accent); color: #fff; }

  #mb-block-{{ block.id }} .mb-name { font-size: .95em; margin: 0 0 4px; }
  #mb-block-{{ block.id }} .mb-price { font-size: .95em; font-weight: 600; }
  #mb-block-{{ block.id }} .mb-price s { opacity: .45; font-weight: 400; margin-left: 6px; }
  #mb-block-{{ block.id }} .mb-from { opacity: .6; font-size: .82em; font-weight: 400; }

  #mb-block-{{ block.id }} .mb-more { text-align: center; padding-top: 28px; }
  #mb-block-{{ block.id }} .mb-btn-more {
    background: none; border: 1px solid currentColor; border-radius: var(--mb-radius);
    padding: 13px 30px; font: inherit; cursor: pointer; color: inherit; opacity: .7;
  }
  #mb-block-{{ block.id }} .mb-btn-more:hover { opacity: 1; border-color: var(--mb-accent); }

  #mb-block-{{ block.id }} .mb-msg { text-align: center; padding: 40px; opacity: .55; }

  /* a shape while it loads, so the page does not jump */
  #mb-block-{{ block.id }} .mb-skel .mb-shot { animation: mbPulse 1.4s ease-in-out infinite; }
  @keyframes mbPulse { 0%,100% { opacity: 1 } 50% { opacity: .5 } }
</style>

<script src="https://admin.modelsboutique.com/api/boutique.js?v=5" defer></script>
<script src="https://admin.modelsboutique.com/api/block.js?v=1" defer></script>

{% schema %}
{
  "name": "Models Boutique",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Your affiliate code"
    },
    {
      "type": "text",
      "id": "affiliate_code",
      "label": "Affiliate code",
      "info": "Filled in when you installed the app. Sales are credited to this code — leave it as it is."
    },
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Under the heading",
      "default": "Hand-picked women's fashion, delivered to your door."
    },
    {
      "type": "header",
      "content": "What to show"
    },
    {
      "type": "checkbox",
      "id": "show_categories",
      "label": "Category filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_more",
      "label": "A show more button",
      "default": true
    },
    {
      "type": "text",
      "id": "more_text",
      "label": "Button text",
      "default": "Show more"
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent colour",
      "default": "#d4a830"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner rounding",
      "min": 0, "max": 24, "step": 2, "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "min_width",
      "label": "Product width",
      "min": 160, "max": 320, "step": 20, "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between products",
      "min": 8, "max": 48, "step": 4, "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
