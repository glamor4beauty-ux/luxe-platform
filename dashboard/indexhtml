<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Luxe Model Collective — Control</title>
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
<style>
  :root{--bg:#0d0f14;--panel:#161a22;--line:#262c38;--txt:#e6e9ef;--mut:#8b93a3;--acc:#e8318a;--ok:#25c26e;--warn:#e0a800;--blue:#388bfd}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--txt);font:15px/1.5 system-ui,Segoe UI,Roboto,sans-serif}
  a{color:inherit}
  /* login gate */
  #gate{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:50}
  .login{width:340px;max-width:92vw;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:26px}
  .login h1{font-size:18px;margin:0 0 4px}
  .login p{color:var(--mut);font-size:13px;margin:0 0 18px}
  .login input{width:100%;background:#0d0f14;border:1px solid var(--line);color:var(--txt);padding:12px 13px;border-radius:10px;font-size:15px;margin-bottom:10px}
  .login button{width:100%;background:var(--acc);color:#fff;border:0;border-radius:10px;padding:13px;font-size:15px;font-weight:700;cursor:pointer}
  .login .err{color:var(--warn);font-size:13px;min-height:18px;margin-top:6px}
  /* shell */
  header{display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid var(--line);flex-wrap:wrap}
  header h1{font-size:17px;margin:0;font-weight:700;white-space:nowrap}
  nav{display:flex;gap:6px;flex-wrap:wrap}
  nav a{color:var(--mut);text-decoration:none;font-size:14px;font-weight:600;padding:8px 14px;border:1px solid var(--line);border-radius:9px;cursor:pointer}
  nav a.active{background:var(--acc);color:#fff;border-color:var(--acc)}
  nav a:hover:not(.active){color:var(--txt);border-color:var(--acc)}
  .who{margin-left:auto;display:flex;align-items:center;gap:12px;font-size:13px;color:var(--mut)}
  .who button{background:#232a36;color:var(--txt);border:0;border-radius:8px;padding:8px 12px;font-size:13px;cursor:pointer}
  main{max-width:1400px;margin:0 auto;padding:22px}
  .pane{display:none} .pane.active{display:block}
  .grid2{display:grid;grid-template-columns:2fr 1fr;gap:20px}
  @media(max-width:900px){.grid2{grid-template-columns:1fr}}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:20px}
  .card h2{margin:0 0 14px;font-size:13px;letter-spacing:.05em;text-transform:uppercase;color:var(--mut)}
  iframe{width:100%;border:0;border-radius:12px;background:#000}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
  input,select{background:#0d0f14;border:1px solid var(--line);color:var(--txt);padding:10px 12px;border-radius:9px;font-size:14px}
  .row input{flex:1;min-width:130px}
  button.b{background:var(--acc);color:#fff;border:0;padding:10px 16px;border-radius:9px;font-weight:600;cursor:pointer}
  button.sec{background:#232a36;color:var(--txt);border:0;padding:10px 16px;border-radius:9px;font-weight:600;cursor:pointer}
  a.linkbtn{display:inline-block;text-decoration:none;background:#232a36;color:var(--txt);padding:10px 16px;border-radius:9px;font-weight:600;font-size:14px}
  a.linkbtn:hover{border:0;background:#2c3444}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line)}
  th{color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.03em}
  .badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:12px;font-weight:600}
  .badge.on{background:rgba(37,194,110,.15);color:var(--ok)} .badge.off{background:#232a36;color:var(--mut)}
  .pub{background:#0d0f14;border:1px solid var(--line);border-radius:9px;padding:12px;font:13px/1.7 ui-monospace,Menlo,monospace;color:var(--mut);word-break:break-all}
  .pub b{color:var(--txt)}
  .hint{color:var(--mut);font-size:13px;margin-top:10px}
  /* targets table */
  .tscroll{overflow-x:auto}
  table.tgt input,table.tgt select{width:100%;min-width:110px;padding:7px 9px;font-size:13px}
  table.tgt td.act{white-space:nowrap;width:1%}
  .iconbtn{background:none;border:1px solid var(--line);color:var(--mut);width:32px;height:32px;padding:0;border-radius:8px;font-size:15px;margin-left:4px;cursor:pointer}
  .iconbtn.save{color:var(--ok);border-color:rgba(37,194,110,.4)}
  .iconbtn.del{color:var(--acc);border-color:rgba(232,49,138,.4)}
  .dirty td{background:rgba(224,168,0,.06)}
  /* monitor */
  .gauges{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px}
  .gauge{background:#0d0f14;border:1px solid var(--line);border-radius:12px;padding:18px;text-align:center}
  .gauge .v{font-size:34px;font-weight:800;line-height:1.1}
  .gauge .l{color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.04em;margin-top:6px}
  .bar{height:8px;background:#232a36;border-radius:6px;overflow:hidden;margin-top:12px}
  .bar > i{display:block;height:100%;background:var(--ok);width:0;transition:width .4s}
  /* vod */
  .vodgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
  .vod{background:#0d0f14;border:1px solid var(--line);border-radius:11px;padding:12px}
  .vod .nm{font-weight:600;word-break:break-all;font-size:14px}
  .vod .meta{color:var(--mut);font-size:12px;margin:6px 0 10px}
  .vod a{color:var(--mut);text-decoration:none;font-size:13px;padding:8px 12px;border:1px solid var(--line);border-radius:8px;margin-right:6px}
</style>
</head>
<body>

<!-- LOGIN GATE -->
<div id="gate">
  <div class="login">
    <h1>💠 Luxe Control</h1>
    <p>Sign in to the streaming console.</p>
    <input id="lu" placeholder="username" autocomplete="username">
    <input id="lp" type="password" placeholder="password" autocomplete="current-password" onkeydown="if(event.key==='Enter')doLogin()">
    <button onclick="doLogin()">Sign in</button>
    <div class="err" id="lerr"></div>
  </div>
</div>

<!-- SHELL (hidden until authed) -->
<div id="app" style="display:none">
  <header>
    <h1>💠 Luxe Model Collective</h1>
    <nav>
      <a class="active" data-tab="kurento" onclick="tab('kurento')">Kurento</a>
      <a data-tab="restream" onclick="tab('restream')">Restream</a>
      <a data-tab="vod" onclick="tab('vod')">VOD</a>
      <a data-tab="monitor" onclick="tab('monitor')">Monitor</a>
      <a data-tab="accounts" onclick="tab('accounts')" id="navAccounts">Accounts</a>
    </nav>
    <div class="who"><span id="whoTxt"></span><button onclick="doLogout()">Sign out</button></div>
  </header>

  <main>
    <!-- KURENTO (live WebRTC) -->
    <div class="pane active" id="pane-kurento">
      <div class="grid2">
        <div class="card">
          <h2>Live Monitor (WebRTC)</h2>
          <iframe id="watchFrame" src="about:blank" style="aspect-ratio:16/9"></iframe>
          <div class="row" style="margin-top:14px">
            <input id="monName" value="stream1" placeholder="stream name to monitor">
            <button class="b" onclick="loadMonitor()">Watch</button>
            <a class="linkbtn" href="/performer.html" target="_blank">📷 Go Live (performer)</a>
          </div>
          <div class="hint">Performers publish from the Go Live page — camera flip is built in. Sub‑second WebRTC.</div>
        </div>
        <div class="card">
          <h2>Active Streams</h2>
          <table><thead><tr><th>Stream</th><th>Status</th></tr></thead>
            <tbody id="streamRows"><tr><td colspan="2" style="color:var(--mut)">Checking…</td></tr></tbody></table>
          <div class="row" style="margin-top:14px">
            <input id="refreshName" value="stream1">
            <button class="sec" onclick="refreshStreams()">Refresh</button>
          </div>
          <h2 style="margin-top:22px">Performer Ingest</h2>
          <div class="pub">RTMP: <b>rtmp://162.35.180.58:1935/live</b><br>Key: <b>stream1</b> (phone apps)</div>
          <div class="hint">WebRTC camera go‑live: <b>/performer.html</b> · viewer: <b>/watch.html</b></div>
        </div>
      </div>
    </div>

    <!-- RESTREAM (ffmpeg) -->
    <div class="pane" id="pane-restream">
      <div class="card">
        <h2>Source &amp; Fan-out</h2>
        <div style="display:flex;gap:22px;flex-wrap:wrap">
          <div style="flex:1;min-width:300px">
            <div class="row">
              <label style="display:flex;align-items:center;gap:6px"><input type="radio" name="srcmode" value="live" onchange="srcMode('live')"> Live stream</label>
              <label style="display:flex;align-items:center;gap:6px"><input type="radio" name="srcmode" value="file" onchange="srcMode('file')"> File → Live (VOD)</label>
            </div>
            <div id="srcLive" class="row">
              <input id="srcUrl" placeholder="rtmp://127.0.0.1:1935/live/stream1">
            </div>
            <div id="srcFile" class="row" style="display:none">
              <select id="srcFileSel" style="flex:1;min-width:180px"><option value="">— pick a recording —</option></select>
              <label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="srcLoop"> Loop</label>
            </div>
            <div class="row">
              <button class="sec" onclick="saveSource()">Save source</button>
              <button class="b" id="startFo" onclick="startFanout()">▶ Start fan-out</button>
              <button class="sec" onclick="stopFanout()">■ Stop</button>
              <span id="foStatus" class="hint" style="margin:0"></span>
            </div>
            <div class="hint">Fan-out copies the source to every <b>enabled</b> RTMP target below (no re-encode). File mode paces the recording out as if live; Loop replays it continuously.</div>
          </div>
          <div style="width:300px;background:#0d0f14;border:1px solid var(--line);border-radius:12px;padding:16px">
            <h2 style="margin-top:0">Upload to VOD</h2>
            <input type="file" id="vodFile" accept="video/mp4,video/webm,video/quicktime,.mp4,.webm,.mov,.m4v" style="width:100%;margin-bottom:10px;font-size:13px">
            <button class="b" id="vodUpBtn" onclick="uploadVod()" style="width:100%">Upload</button>
            <div class="bar" style="margin-top:12px"><i id="vodProg" style="background:var(--blue)"></i></div>
            <div class="hint" id="vodUpMsg" style="margin-top:8px">mp4 / webm / mov. Lands in the VOD library and the File→Live list. Re-upload same name to replace.</div>
          </div>
        </div>
      </div>
      <div class="card">
        <h2>Publish / Restream Targets</h2>
        <div class="tscroll"><table class="tgt">
          <thead><tr><th>On</th><th>Platform</th><th>Protocol</th><th>Server</th><th>Key</th><th>Region</th><th></th></tr></thead>
          <tbody id="tgtRows"><tr><td colspan="7" style="color:var(--mut)">Loading…</td></tr></tbody></table></div>
        <div class="row" style="margin-top:14px">
          <button class="sec" onclick="addTarget()">+ Add target</button>
        </div>
        <div class="hint">Tick <b>On</b> to include a target in the fan-out. ✓ saves a row · ✕ deletes. X / YouTube / Facebook / Twitch all run on ffmpeg.</div>
      </div>
    </div>

    <!-- VOD -->
    <div class="pane" id="pane-vod">
      <div class="card">
        <h2>VOD Library</h2>
        <div id="vodGrid" class="vodgrid"><div class="hint">Loading recordings…</div></div>
        <div class="hint">Recordings land automatically when a live stream ends. Newest first.</div>
      </div>
    </div>

    <!-- MONITOR -->
    <div class="pane" id="pane-monitor">
      <div class="card">
        <h2>Server Load — 162.35.180.58</h2>
        <div class="gauges">
          <div class="gauge"><div class="v" id="gCpu">–</div><div class="l">CPU %</div><div class="bar"><i id="bCpu"></i></div></div>
          <div class="gauge"><div class="v" id="gLoad">–</div><div class="l">Load (1m / cores)</div><div class="bar"><i id="bLoad"></i></div></div>
          <div class="gauge"><div class="v" id="gMem">–</div><div class="l">Memory %</div><div class="bar"><i id="bMem"></i></div></div>
        </div>
        <div class="hint" id="loadDetail">Live — refreshes every 3s. Watch this during WebRTC + restream load.</div>
      </div>
    </div>

    <!-- ACCOUNTS -->
    <div class="pane" id="pane-accounts">
      <div class="card">
        <h2>Add / Update User</h2>
        <div class="row">
          <input id="acUser" placeholder="username">
          <input id="acPass" type="password" placeholder="password (blank = keep, on update)">
          <select id="acRole"><option value="performer">performer</option><option value="admin">admin</option></select>
          <button class="b" onclick="saveAccount()">Save</button>
        </div>
        <div class="hint" id="acMsg">One login across <code>*.divafans.club</code>. Signed in as <b id="acctWho"></b>.</div>
      </div>
      <div class="card">
        <h2>Users</h2>
        <table><thead><tr><th>Username</th><th>Role</th><th></th></tr></thead>
          <tbody id="acRows"><tr><td colspan="3" style="color:var(--mut)">Loading…</td></tr></tbody></table>
      </div>
    </div>
  </main>
</div>

<script>
const $=id=>document.getElementById(id);
const clean=s=>(s||'').replace(/[^a-zA-Z0-9_-]/g,'')||'stream1';

/* ---- auth ---- */
async function checkAuth(){
  try{ const d=await (await fetch('api/me.php',{cache:'no-store'})).json();
    if(d.ok){ showApp(d); return; } }catch(e){}
  $('gate').style.display='flex'; $('app').style.display='none';
}
function showApp(d){
  $('gate').style.display='none'; $('app').style.display='block';
  $('whoTxt').textContent=d.user+' · '+d.role;
  $('acctWho').textContent=d.user+' ('+d.role+')';
  if(d.role!=='admin') $('navAccounts').style.display='none';
  bootTabs();
}
async function doLogin(){
  $('lerr').textContent='';
  const r=await fetch('api/login.php',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({username:$('lu').value.trim(),password:$('lp').value})});
  const d=await r.json();
  if(d.ok) showApp(d); else $('lerr').textContent='Invalid username or password.';
}
async function doLogout(){ await fetch('api/logout.php'); location.reload(); }

/* ---- tabs ---- */
let booted=false;
function tab(name){
  document.querySelectorAll('nav a').forEach(a=>a.classList.toggle('active',a.dataset.tab===name));
  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('active',p.id==='pane-'+name));
  if(name==='monitor') startMonitor(); else stopMonitor();
  if(name==='restream') startRestreamPoll(); else stopRestreamPoll();
  if(name==='accounts') loadAccounts();
}
function bootTabs(){
  if(booted) return; booted=true;
  refreshStreams(); setInterval(refreshStreams,8000);
  loadTargets(); loadVOD(); setInterval(loadVOD,30000);
}

/* ---- Kurento tab ---- */
function loadMonitor(){ const n=clean($('monName').value); const f=$('watchFrame');
  f.style.aspectRatio='16/9'; f.style.width='100%'; f.style.height='auto'; f.style.maxHeight='75vh';
  f.src='/watch.html?embed=1&name='+encodeURIComponent(n); }
/* auto-adapt the monitor frame to the live video's orientation (wide for landscape, tall for portrait) */
window.addEventListener('message',e=>{
  const d=e.data; if(!d||d.type!=='luxe-aspect'||!(d.ratio>0)) return;
  const f=$('watchFrame'); f.style.aspectRatio=d.ratio.toFixed(4); f.style.margin='0 auto'; f.style.display='block';
  if(d.ratio>=1){ f.style.width='100%'; f.style.height='auto'; f.style.maxHeight='75vh'; }
  else          { f.style.width='auto'; f.style.height='75vh'; f.style.maxHeight='75vh'; }
});
async function refreshStreams(){
  const name=clean($('refreshName').value), tb=$('streamRows');
  let rows='';
  try{ const k=await (await fetch('api/krooms.php?_='+Date.now())).json();
    (k.rooms||[]).forEach(r=>{ rows+=`<tr style="cursor:pointer" onclick="$('monName').value='${r.name}';loadMonitor()"><td>${r.name}</td>
      <td><span class="badge on">WebRTC LIVE</span> <span style="color:var(--mut);font-size:12px">${r.viewers} viewer(s) ▶</span></td></tr>`; });
  }catch(e){}
  try{ const d=await (await fetch('api/streams.php?action=list&_='+Date.now())).json();
    if(d.ok&&d.streams){ d.streams.forEach(s=>{ rows+=`<tr style="cursor:pointer" onclick="$('monName').value='${s.name}';loadMonitor()"><td>${s.name}</td>
      <td><span class="badge ${s.live?'on':'off'}">${s.live?'LIVE':'idle'}</span> <span style="color:var(--mut);font-size:12px">RTMP ▶</span></td></tr>`; }); }
  }catch(e){}
  tb.innerHTML = rows || `<tr style="cursor:pointer" onclick="$('monName').value='${name}';loadMonitor()"><td>${name}</td>
    <td><span class="badge off">idle</span> <span style="color:var(--mut);font-size:12px">▶ watch</span></td></tr>`;
}

/* ---- Restream tab: targets ---- */
const PROTOS=['RTMP','RTSP','SRT'], esc=s=>(s||'').replace(/"/g,'&quot;');
function tgtRowHTML(t){
  const opts=PROTOS.map(p=>`<option ${t.protocol===p?'selected':''}>${p}</option>`).join('');
  return `<tr data-id="${esc(t.id)}">
    <td style="text-align:center"><input type="checkbox" class="c-enabled" ${t.enabled?'checked':''}></td>
    <td><input class="c-platform" value="${esc(t.platform)}" placeholder="Platform"></td>
    <td><select class="c-protocol">${opts}</select></td>
    <td><input class="c-server" value="${esc(t.server)}" placeholder="rtmp://host/app"></td>
    <td><input class="c-key" value="${esc(t.key)}" placeholder="stream key"></td>
    <td><input class="c-region" value="${esc(t.region)}" placeholder="—"></td>
    <td class="act"><button class="iconbtn save" onclick="saveTarget(this)">✓</button><button class="iconbtn del" onclick="deleteTarget(this)">✕</button></td></tr>`;
}
async function loadTargets(){
  const tb=$('tgtRows');
  try{ const d=await (await fetch('api/targets.php?action=list&_='+Date.now())).json();
    tb.innerHTML=(d.targets&&d.targets.length)?d.targets.map(tgtRowHTML).join(''):''; if(!tb.innerHTML) addTarget();
    tb.querySelectorAll('tr').forEach(tr=>tr.querySelectorAll('input,select').forEach(el=>el.addEventListener('input',()=>tr.classList.add('dirty'))));
  }catch(e){ tb.innerHTML='<tr><td colspan=7 style="color:var(--mut)">Targets unavailable</td></tr>'; }
}
function rowData(btn){ const tr=btn.closest('tr'); return {tr,data:{id:tr.dataset.id||'',
  platform:tr.querySelector('.c-platform').value.trim(),protocol:tr.querySelector('.c-protocol').value,
  server:tr.querySelector('.c-server').value.trim(),key:tr.querySelector('.c-key').value.trim(),region:tr.querySelector('.c-region').value.trim(),
  enabled:tr.querySelector('.c-enabled').checked}}; }
/* toggling the On checkbox saves immediately */
document.addEventListener('change',e=>{ if(e.target.classList&&e.target.classList.contains('c-enabled')){ const b=e.target.closest('tr').querySelector('.iconbtn.save'); if(b) saveTarget(b); }});
async function saveTarget(btn){ const {tr,data}=rowData(btn);
  const r=await (await fetch('api/targets.php?action=save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})).json();
  if(r.ok){ tr.dataset.id=r.id; tr.classList.remove('dirty'); } }
async function deleteTarget(btn){ const {tr,data}=rowData(btn);
  if(data.id) await fetch('api/targets.php?action=delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:data.id})}); tr.remove(); }
function addTarget(){ const tb=$('tgtRows'); tb.insertAdjacentHTML('beforeend',tgtRowHTML({id:'',platform:'',protocol:'RTMP',server:'',key:'',region:''}));
  const tr=tb.lastElementChild; tr.classList.add('dirty'); tr.querySelectorAll('input,select').forEach(el=>el.addEventListener('input',()=>tr.classList.add('dirty'))); }

/* ---- Restream: source + fan-out ---- */
let foTimer=null;
function srcMode(m){
  $('srcLive').style.display = m==='live'?'flex':'none';
  $('srcFile').style.display = m==='file'?'flex':'none';
  document.querySelectorAll('input[name=srcmode]').forEach(r=>r.checked=(r.value===m));
}
async function loadSource(){
  // populate file dropdown from VOD
  try{ const v=await (await fetch('api/vod.php?_='+Date.now())).json();
    const sel=$('srcFileSel'); sel.innerHTML='<option value="">— pick a recording —</option>'+
      (v.files||[]).map(f=>`<option value="${f.name}">${f.name}</option>`).join('');
  }catch(e){}
  try{ const d=await (await fetch('api/restream.php?action=getsource&_='+Date.now())).json();
    const s=d.source||{}; const mode=s.mode||'live';
    $('srcUrl').value=s.url||'rtmp://127.0.0.1:1935/live/stream1';
    if(s.file) $('srcFileSel').value=s.file; $('srcLoop').checked=!!s.loop;
    srcMode(mode);
  }catch(e){ srcMode('live'); }
}
async function saveSource(){
  const mode=document.querySelector('input[name=srcmode]:checked')?.value||'live';
  const body={mode,url:$('srcUrl').value.trim(),file:$('srcFileSel').value,loop:$('srcLoop').checked};
  const d=await (await fetch('api/restream.php?action=setsource',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})).json();
  $('foStatus').textContent=d.ok?'Source saved.':'Save failed.';
}
async function startFanout(){
  await saveSource();
  $('startFo').disabled=true;
  const d=await (await fetch('api/restream.php?action=start')).json();
  $('startFo').disabled=false;
  if(!d.ok){ $('foStatus').textContent=d.error||'Start failed.'; return; }
  $('foStatus').textContent='Started '+d.count+' target(s)'+(d.skipped&&d.skipped.length?' · skipped: '+d.skipped.join(', '):'');
  pollFanout();
}
async function stopFanout(){ await fetch('api/restream.php?action=stop'); $('foStatus').textContent='Stopped.'; pollFanout(); }
async function pollFanout(){
  try{ const d=await (await fetch('api/restream.php?action=status&_='+Date.now())).json();
    if(d.ok){ $('foStatus').textContent = d.live ? ('● LIVE → '+d.running.join(', ')) : 'Idle — not fanning out.';
      $('foStatus').style.color = d.live?'var(--ok)':'var(--mut)'; }
  }catch(e){}
}
function startRestreamPoll(){ loadSource(); pollFanout(); if(!foTimer) foTimer=setInterval(pollFanout,5000); }
function stopRestreamPoll(){ if(foTimer){ clearInterval(foTimer); foTimer=null; } }
/* upload a video into VOD storage */
function uploadVod(){
  const inp=$('vodFile'); if(!inp.files||!inp.files.length){ $('vodUpMsg').textContent='Pick a file first.'; return; }
  const fd=new FormData(); fd.append('file',inp.files[0]);
  const xhr=new XMLHttpRequest(); xhr.open('POST','api/vod-upload.php');
  $('vodUpBtn').disabled=true; $('vodUpMsg').textContent='Uploading…';
  xhr.upload.onprogress=e=>{ if(e.lengthComputable){ const p=Math.round(100*e.loaded/e.total); $('vodProg').style.width=p+'%'; $('vodUpMsg').textContent='Uploading… '+p+'%'; } };
  xhr.onload=()=>{ $('vodUpBtn').disabled=false;
    let d={}; try{ d=JSON.parse(xhr.responseText); }catch(e){}
    if(d.ok){ $('vodUpMsg').textContent='Uploaded: '+d.name; $('vodProg').style.width='100%'; inp.value='';
      loadSource(); loadVOD(); setTimeout(()=>{$('vodProg').style.width='0%';},1500); }
    else { $('vodUpMsg').textContent=(d.error||'Upload failed'); $('vodProg').style.width='0%'; } };
  xhr.onerror=()=>{ $('vodUpBtn').disabled=false; $('vodUpMsg').textContent='Upload failed (network/size).'; $('vodProg').style.width='0%'; };
  xhr.send(fd);
}

/* ---- VOD tab ---- */
function fmtSize(b){ if(b<1048576)return (b/1024).toFixed(0)+' KB'; if(b<1073741824)return (b/1048576).toFixed(1)+' MB'; return (b/1073741824).toFixed(2)+' GB'; }
async function loadVOD(){ const g=$('vodGrid');
  try{ const d=await (await fetch('api/vod.php?_='+Date.now())).json();
    g.innerHTML=(d.ok&&d.files&&d.files.length)?d.files.map(f=>`<div class="vod"><div class="nm">${f.name}</div>
      <div class="meta">${fmtSize(f.size)} · ${new Date(f.mtime*1000).toLocaleString()}</div>
      <div><a href="${f.url}" target="_blank">▶ Play</a><a href="${f.url}" download>Download</a></div></div>`).join('')
      :'<div class="hint">No recordings yet.</div>';
  }catch(e){ g.innerHTML='<div class="hint">VOD unavailable.</div>'; }
}

/* ---- Accounts tab ---- */
async function loadAccounts(){
  const tb=$('acRows');
  try{ const d=await (await fetch('api/accounts.php?action=list&_='+Date.now())).json();
    tb.innerHTML=(d.users||[]).map(u=>`<tr><td>${u.username}</td><td>${u.role}</td>
      <td class="act"><button class="sec" onclick="resetPw('${u.username}')">Reset pw</button>
      <button class="iconbtn del" onclick="delAccount('${u.username}')" title="Delete">✕</button></td></tr>`).join('')
      ||'<tr><td colspan=3 style="color:var(--mut)">no users</td></tr>';
  }catch(e){ tb.innerHTML='<tr><td colspan=3 style="color:var(--mut)">unavailable</td></tr>'; }
}
async function saveAccount(){
  const b={username:$('acUser').value.trim(),password:$('acPass').value,role:$('acRole').value};
  const d=await (await fetch('api/accounts.php?action=save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)})).json();
  $('acMsg').textContent=d.ok?'Saved.':(d.error||'Failed.');
  if(d.ok){ $('acUser').value=''; $('acPass').value=''; loadAccounts(); }
}
async function resetPw(u){
  const p=prompt('New password for '+u+':'); if(!p) return;
  const d=await (await fetch('api/accounts.php?action=save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})})).json();
  $('acMsg').textContent=d.ok?('Password reset for '+u):(d.error||'Failed.');
}
async function delAccount(u){
  if(!confirm('Delete user "'+u+'"?')) return;
  const d=await (await fetch('api/accounts.php?action=delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u})})).json();
  if(d.ok) loadAccounts(); else $('acMsg').textContent=d.error||'Failed.';
}

/* ---- Monitor tab ---- */
let monTimer=null;
async function pollMon(){
  try{ const d=await (await fetch('api/cpu.php?_='+Date.now())).json();
    if(!d.ok) return;
    const set=(v,b,val,pct,suffix)=>{ $(v).textContent=val; const i=$(b); i.style.width=Math.min(100,pct)+'%';
      i.style.background = pct>85?'var(--acc)':pct>60?'var(--warn)':'var(--ok)'; };
    set('gCpu','bCpu',d.cpu+'%',d.cpu);
    set('gLoad','bLoad',d.load['1m'].toFixed(2),d.load_pct);
    if(d.mem_pct!=null) set('gMem','bMem',d.mem_pct+'%',d.mem_pct); else $('gMem').textContent='—';
    $('loadDetail').textContent=`load ${d.load['1m']} / ${d.load['5m']} / ${d.load['15m']} · ${d.cores} cores · refreshing every 3s`;
  }catch(e){}
}
function startMonitor(){ pollMon(); if(!monTimer) monTimer=setInterval(pollMon,3000); }
function stopMonitor(){ if(monTimer){ clearInterval(monTimer); monTimer=null; } }

checkAuth();
</script>
